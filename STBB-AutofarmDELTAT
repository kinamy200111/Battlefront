		local wave = ws:FindFirstChild("Wave") and ws.Wave.Value or 0
		-- reset wave (titan side, the normal farm heartbeat returns here)
		if st.titanResetWave and st.titanResetWave > 0 then
			if wave >= st.titanResetWave and not TS.resetDone then
				hrp.CFrame = CFrame.new(hrp.Position.X, -175, hrp.Position.Z)
				TS.resetDone = true
				print("[rathub-titan] reset: under map (wave " .. tostring(wave) .. ")")
				return
			elseif wave < st.titanResetWave then
				TS.resetDone = false
			end
		end
		-- M1 spams all the time, together with abilities
		if st.titanM1 and t - TS.lmb >= 0.1 and t >= (TS.castUntil or 0) then
			TS.lmb = t
			local cdf = char:FindFirstChild("CooldownFolder")
			local am1 = cdf and cdf:FindFirstChild("ActiveM1")
			local lb = cdf and cdf:FindFirstChild("LMBActive")
			if not ((am1 and am1.Value == true) or (lb and lb.Value == true)) then
				pcall(function()
					rs.LMB:FireServer()
				end)
			end
		end

		if t - TS.scan >= 0.5 then
			TS.scan = t
			TS.mobs = scanMobs(hrp)
		end
		local target = titanPickTarget(TS.mobs)
		if not target then
			-- no enemies: stay in one position (like the normal farm)
			TS.target = nil
			TS.orbiting = false
			TS.angleInit = false
			if st._clearAim and st.silentAim then
				st._clearAim()
			end
			return
		end
		TS.target = { name = target.name, mx = target.mx, pos = tpos }
		local tpos
		pcall(function()
			tpos = target.root.Position
		end)
		if not tpos then
			tpos = target.pos
		end
		target.pos = tpos
		if st.silentAim and t - TS.aimT >= (tonumber(st.silentAimRate) or 0.05) then
			TS.aimT = t
			sendSilentAim(target, hrp)
		end
		local ppos = hrp.Position
		local flatT = Vector3.new(tpos.X, ppos.Y, tpos.Z)
		local dist = (flatT - ppos).Magnitude

		if dist > keep + 3 then
			-- approach: stay at orbit radius, feet on the ground
			TS.angleInit = false
			TS.orbiting = false
			local dir = Vector3.new(ppos.X - flatT.X, 0, ppos.Z - flatT.Z)
			if dir.Magnitude < 0.01 then
				dir = Vector3.new(0, 0, 1)
			end
			dir = dir.Unit
			local goal = flatT + dir * keep
			local step = math.min(st.titanSpeed * dt, math.max(dist - keep, 0))
			local flat = Vector3.new(goal.X, ppos.Y, goal.Z)
			local toGoal = flat - ppos
			local np = ppos + (toGoal.Magnitude > 0.01 and toGoal.Unit * math.min(step, toGoal.Magnitude) or Vector3.new(0, 0, 0))
			local gy = titanGroundY(char, np.X, np.Z, ppos.Y)
			local y = (gy or TS.lastY or ppos.Y) + st.titanFeetOffset
			TS.lastY = y
			setPosFacing(hrp, Vector3.new(np.X, y, np.Z), tpos)
		else
			-- orbit the target on the ground
			TS.orbiting = true
			if not TS.angleInit then
				local off = ppos - flatT
				TS.angle = math.atan2(off.Z, off.X)
				TS.angleInit = true
			end
			TS.angle = TS.angle + math.rad(st.titanOrbitDeg) * dt
			local orb = tpos + Vector3.new(math.cos(TS.angle) * keep, 0, math.sin(TS.angle) * keep)
			local gy = titanGroundY(char, orb.X, orb.Z, ppos.Y)
			local y = (gy or TS.lastY or ppos.Y) + st.titanFeetOffset
			TS.lastY = y
			setPosFacing(hrp, Vector3.new(orb.X, y, orb.Z), tpos)
		end
	end)
	if not ok and t - TS.err > 5 then
		TS.err = t
		print("[rathub-titan] " .. tostring(err))
	end
end)

local function parseMasteryList(text)
	local out = {}
	for line in (text or ""):gmatch("[^\r\n;]+") do
		line = line:gsub("^%s+", ""):gsub("%s+$", "")
		if line ~= "" and line:sub(1, 1) ~= "#" then
			local name, cap = line:match("^(.-)%s*|%s*(%d+)%s*$")
			if name and name ~= "" then
				out[#out + 1] = { name = name, cap = tonumber(cap) }
			else
				out[#out + 1] = { name = line, cap = nil }
			end
		end
	end
	return out
end

local function dataFolder()
	return lp:FindFirstChild("_Data")
end

local function masteryOf(name)
	local d = dataFolder()
	local f = d and d:FindFirstChild("Mastery")
	if not f then
		return nil
	end
	local v = f:FindFirstChild(name .. ":Mastery")
	if not v then
		for _, c in ipairs(f:GetChildren()) do
			if c.Name:gsub(":Mastery$", "") == name then
				v = c
				break
			end
		end
	end
	if not v then
		return nil
	end
	local n = tostring(v.Value):match("^(%-?%d+)")
	return n and tonumber(n) or nil
end

local function isUnlocked(name)
	local d = dataFolder()
	local u = d and d:FindFirstChild("UnlockedCharacter")
	if not u then
		return true
	end
	return u:FindFirstChild(name) ~= nil
end

local function switchCharacter(name)
	local d = dataFolder()
	local cv = d and d:FindFirstChild("Character")
	if not cv then
		return false
	end
	if cv.Value == name then
		return true
	end
	local rem = rs:FindFirstChild("ForChangeCharacter")
	if not rem then
		return false
	end
	pcall(function()
		rem:FireServer(name, 0)
	end)
	for _ = 1, 24 do
		task.wait(0.25)
		if cv.Value == name then
			return true
		end
	end
	return false
end

function Party.update()
	local wave = ws:FindFirstChild("Wave") and ws.Wave.Value or 0
	local living = ws:FindFirstChild("Living")
	local inArena = lp.Character and living and lp.Character.Parent == living
	local pv = lp:FindFirstChild("PlayerValues")
	local cv = pv and pv:FindFirstChild("Character")
	local charName = cv and cv.Value or ""
	local voting = ws:FindFirstChild("Voteing") and ws.Voteing.Value == true
	local phase = if (wave > 0 or inArena) then "game" elseif voting then "vote" else "ready"
	local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
	local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	local pos = hrp and { x = hrp.Position.X, y = hrp.Position.Y, z = hrp.Position.Z } or nil
	local tgt = nil
	if Party.role == "Main" then
		local src = (isTitanForm() and TS and TS.target) or currentTarget
		if src and src.name then
			local tp = src.pos
			if not tp and src.root then
				pcall(function()
					tp = src.root.Position
				end)
			end
			tgt = {
				name = tostring(src.name),
				x = tp and tp.X or nil,
				y = tp and tp.Y or nil,
				z = tp and tp.Z or nil,
			}
		end
	end
	local data = {
		mode = st.voteMode,
		wantVote = st.vote,
		wantReady = st.ready,
		supportMode = Party.supportMode,
		char = charName,
		wave = wave,
		cen = getCen(),
		phase = phase,
		path = st.pathPreset,
		hp = hum and hum.Health or 0,
		maxhp = hum and hum.MaxHealth or 0,
		pos = pos,
		target = tgt,
		look = hrp and { x = hrp.CFrame.LookVector.X, y = hrp.CFrame.LookVector.Y, z = hrp.CFrame.LookVector.Z } or nil,
	}
	if Party.role == "Main" then
		data.wantVote = st.vote or st._pathForced or st.pathBoostFarmActive or st.pathFallbackActive
		Party.write("main", data)
		local support = Party.read("support")
		Party.partner = Party.fresh(support) and support or nil
	else
		Party.write("support", data)
		local main = Party.read("main")
		Party.partner = Party.fresh(main) and main or nil
		if Party.partner and Party.followVote then
			st.voteMode = Party.partner.mode or st.voteMode
			st.vote = Party.partner.wantVote == true
			st.ready = Party.partner.wantReady == true
		end
		if Party.supportMode == "Assist" and Party.partner and Party.partner.target then
			Party.assistTarget = Party.partner.target
		else
			Party.assistTarget = nil
		end
		if Party.followChar and Party.partner and Party.partner.char and Party.partner.char ~= "" and wave == 0 and not inArena then
			if charName ~= Party.partner.char and os.time() - (Party.lastCharAttempt or 0) >= 3 then
				Party.lastCharAttempt = os.time()
				switchCharacter(Party.partner.char)
			end
		end
	end
	Party.updateStatus()
end

