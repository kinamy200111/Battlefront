function st._pathForce(active)
	if active then
		if not st._pathForced then
			st._pathForced = true
			st._pathSaved = {
				titanFarm = st.titanFarm,
				titanAuto = st.titanAutoRequest,
				vote = st.vote,
				voteMode = st.voteMode,
			}
		end
		st.titanFarm = true
		st.titanAutoRequest = true
		st.vote = true
		st.voteMode = "Hard"
		pcall(function()
			setToggle(titanToggle, true)
		end)
		if titanAutoRequestToggle then
			pcall(function()
				setToggle(titanAutoRequestToggle, true)
			end)
		end
	elseif st._pathForced then
		st._pathForced = false
		st.titanFarm = st._pathSaved.titanFarm or false
		st.titanAutoRequest = st._pathSaved.titanAuto or false
		st.vote = st._pathSaved.vote or false
		st.voteMode = st._pathSaved.voteMode or st.voteMode
		pcall(function()
			setToggle(titanToggle, st.titanFarm)
		end)
		if titanAutoRequestToggle then
			pcall(function()
				setToggle(titanAutoRequestToggle, st.titanAutoRequest)
			end)
		end
	end
end

