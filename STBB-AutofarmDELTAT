local function toOneLine(s)
	local t = tostring(s or ""):gsub("[ \t]*\r?\n[ \t]*", "; ")
	return t
end

local function toMultiMap(list)
	local m = {}
	if type(list) == "table" then
		for k, v in pairs(list) do
			if type(k) == "number" then
				m[tostring(v)] = true
			elseif v then
				m[tostring(k)] = true
			end
		end
	end
	return m
end

local function multiNames(v)
	local out = {}
	if type(v) == "table" then
		for k, x in pairs(v) do
			if type(k) == "number" then
				local s = tostring(x)
				if s ~= "" then
					out[#out + 1] = s
				end
			elseif x then
				local s = tostring(k)
				if s ~= "" then
					out[#out + 1] = s
				end
			end
		end
	elseif v ~= nil and tostring(v) ~= "" then
		out[1] = tostring(v)
	end
	return out
end

