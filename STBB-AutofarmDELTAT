local BOT_BRIDGE
local AIM_OVERRIDE_FORCED = false

local function getBotBridge()
	if BOT_BRIDGE and type(BOT_BRIDGE) == "table" and BOT_BRIDGE.GetAimPosition then
		return BOT_BRIDGE
	end
	local mod = rs:FindFirstChild("BotBridge")
	if not mod then
		return nil
	end
	local ok, bb = pcall(require, mod)
	if ok and type(bb) == "table" then
		BOT_BRIDGE = bb
		return bb
	end
	return nil
end

local function clearAimOverride()
	local bb = getBotBridge()
	if bb and AIM_OVERRIDE_FORCED then
		pcall(function()
			bb.AimPosition = nil
			bb.Enabled = false
		end)
	end
	AIM_OVERRIDE_FORCED = false
end
st._clearAim = clearAimOverride

-- The game already wraps MouseStream through BotBridge: when Enabled +
-- AimPosition are set, every stream packet (the client's own heartbeat too)
-- is redirected to that point. This is the only reliable silent aim, because
-- extra MouseStream packets get overwritten by the game's own packets.
local function setAimTarget(pos)
	local bb = getBotBridge()
	if not bb then
		return false
	end
	if not pos then
		clearAimOverride()
		return false
	end
	if not bb.Enabled then
		AIM_OVERRIDE_FORCED = true
	end
	pcall(function()
		bb.Enabled = true
		bb.AimPosition = pos
	end)
	return true
end

local function mouseHitLook()
	local bb = getBotBridge()
	local cam = workspace.CurrentCamera
	if bb and bb.Enabled and bb.AimPosition then
		local dir = bb.AimPosition - cam.CFrame.Position
		return bb.AimPosition, (dir.Magnitude > 0 and dir.Unit or cam.CFrame.LookVector)
	end
	local mouse = lp:GetMouse()
	local hit = mouse and mouse.Hit
	return hit and hit.Position or nil, cam and cam.CFrame.LookVector or nil
end

-- Held abilities (UTSM Galting/Core, X18 Core/Laser, ...) only work when the
-- server gets a matching HoldStateSync pair. Firing the skill remote alone
-- starts a cast but never keeps/releases it correctly.
local function holdSkillRemote(skillRemoteName, holdName, duration)
	local rem = rs:FindFirstChild(skillRemoteName)
	local hs = rs:FindFirstChild("HoldStateSync")
	local fired = false
	if hs and holdName and holdName ~= "" then
		pcall(function()
			hs:FireServer(holdName, true)
		end)
		fired = true
	end
	if rem then
		pcall(function()
			rem:FireServer()
		end)
		fired = true
	end
	if not fired then
		return false
	end
	if _G.SendMouseNow then
		pcall(function()
			_G.SendMouseNow()
		end)
	end
	local dur = math.max(tonumber(duration) or 1.5, 0.2)
	task.delay(dur, function()
		if hs and holdName and holdName ~= "" then
			pcall(function()
				hs:FireServer(holdName, false)
			end)
		end
	end)
	return true
end

local function holdSkillActivate(skillId, displayName, duration)
	local sa = rs:FindFirstChild("SkillActivate")
	if not sa then
		return holdSkillRemote(skillId, nil, duration)
	end
	local pos, look = mouseHitLook()
	pcall(function()
		sa:FireServer(skillId, pos, look, "press", displayName or skillId)
	end)
	if _G.SendMouseNow then
		pcall(function()
			_G.SendMouseNow()
		end)
	end
	local dur = math.max(tonumber(duration) or 1.5, 0.2)
	task.delay(dur, function()
		local p2, l2 = mouseHitLook()
		pcall(function()
			sa:FireServer(skillId, p2, l2, "release", displayName or skillId)
		end)
	end)
	return true
end

local function sendSilentAim(target, hrp)
	if not target or not hrp then
		return
	end
	local aimPart = target.mob and target.mob:FindFirstChild("Head") or target.root
	local pos = aimPart and aimPart.Position or target.pos
	if not pos then
		return
	end
	if setAimTarget(pos) then
		pcall(function()
			if _G.SendMouseNow then
				_G.SendMouseNow()
			end
		end)
		return
	end
	local ms = rs:FindFirstChild("MouseStream")
	if not ms then
		return
	end
	local dir = pos - hrp.Position
	if dir.Magnitude < 0.01 then
		return
	end
	pcall(function()
		ms:FireServer(pos, dir.Unit, false)
	end)
end

