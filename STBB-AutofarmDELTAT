local function isGearName(name)
	local nk = normKey(name)
	if #nk < 3 then
		return false
	end
	if gearKeys[nk] then
		return true
	end
	for gk in pairs(gearKeys) do
		if nk:find(gk, 1, true) or gk:find(nk, 1, true) then
			return true
		end
	end
	return false
end

local function itemPrompt(item)
	if item:IsA("ProximityPrompt") then
		return item
	end
	local ok, p = pcall(function()
		return item:FindFirstChildWhichIsA("ProximityPrompt", true)
	end)
	if ok then
		return p
	end
	return nil
end

local function itemPos(item)
	local ok, pos = pcall(function()
		if item:IsA("BasePart") then
			return item.Position
		end
		return item:GetPivot().Position
	end)
	if ok and type(pos) == "Vector3" then
		return pos
	end
	local pr = itemPrompt(item)
	if pr and pr.Parent then
		local par = pr.Parent
		if par:IsA("BasePart") then
			return par.Position
		elseif par:IsA("Model") then
			local ok2, p2 = pcall(function()
				return par:GetPivot().Position
			end)
			if ok2 then
				return p2
			end
		end
	end
	return nil
end

local LOOT_SCAN_NODES = 40000
local LOOT_SCAN_TIME = 0.025

local lootCache = {}
local lootScanRound = 0

local function promptPos(pr)
	local par = pr.Parent
	if not par then
		return nil
	end
	if par:IsA("BasePart") then
		return par.Position
	end
	if par:IsA("Attachment") then
		local ok, p = pcall(function()
			return par.WorldPosition
		end)
		if ok then
			return p
		end
	end
	return itemPos(par)
end

local function promptOwner(pr)
	local p = pr
	for _ = 1, 6 do
		p = p.Parent
		if not p or p == ws then
			break
		end
		if isGearName(p.Name) then
			return p
		end
	end
	return nil
end

local function listLoot(hrp)
	if next(gearKeys) == nil then
		refreshGearNames()
	end
	local ppos = hrp.Position
	local nodes = LOOT_SCAN_NODES
	local deadline = os.clock() + LOOT_SCAN_TIME
	local complete = true
	local found = {}
	local seen = {}

	local function consider(inst, pr)
		if seen[inst] then
			return
		end
		seen[inst] = true
		if not (pr and pr.Parent and pr.Enabled) then
			return
		end
		local pos = promptPos(pr) or itemPos(inst)
		if not pos then
			return
		end
		found[inst] = { inst = inst, prompt = pr, pos = pos, dist = (ppos - pos).Magnitude }
	end

	local function walk(container, rotate)
		local kids = container:GetChildren()
		local n = #kids
		local first = 1
		if rotate and n > 1 then
			lootScanRound = lootScanRound + 1
			first = (lootScanRound % n) + 1
		end
		for i = 1, n do
			if not complete then
				return
			end
			local idx = first + i - 1
			if idx > n then
				idx = idx - n
			end
			local w = kids[idx]
			if nodes <= 0 or os.clock() > deadline then
				complete = false
				return
			end
			nodes = nodes - 1
			if w:IsA("ProximityPrompt") then
				local owner = promptOwner(w)
				if owner then
					consider(owner, w)
				end
			elseif isGearName(w.Name) then
				local pr = itemPrompt(w)
				if pr then
					consider(w, pr)
				end
			end
			if not w:IsA("ProximityPrompt") and #w:GetChildren() > 0 then
				walk(w, false)
			end
		end
	end
	walk(ws, true)

	for inst, e in pairs(lootCache) do
		if not found[inst] and inst.Parent and e.prompt and e.prompt.Parent then
			local pos = promptPos(e.prompt) or itemPos(inst)
			if pos then
				found[inst] = { inst = inst, prompt = e.prompt, pos = pos, dist = (ppos - pos).Magnitude }
			end
		end
	end
	lootCache = found

	local out = {}
	for _, e in pairs(found) do
		out[#out + 1] = e
	end
	table.sort(out, function(a, b)
		return a.dist < b.dist
	end)
	return out
end

local function pressE(hold, prompt)
	local h = math.max(tonumber(hold) or 0.2, 0.15)
	if prompt then
		local okB = pcall(function()
			prompt:InputHoldBegin()
		end)
		if okB then
			task.wait(h)
			pcall(function()
				prompt:InputHoldEnd()
			end)
			task.wait(0.25)
			return
		end
	end
	if VIM then
		pcall(function()
			VIM:SendKeyEvent(true, Enum.KeyCode.E, false, lp)
		end)
		task.wait(h)
		pcall(function()
			VIM:SendKeyEvent(false, Enum.KeyCode.E, false, lp)
		end)
	end
	task.wait(0.25)
end

local lootBusy = false
local lootTarget = nil
local lootLastT = 0

local function lootPick(entry, hrp)
	if lootBusy then
		return
	end
	lootBusy = true
	task.spawn(function()
		local inst, pr = entry.inst, entry.prompt
		local ok, err = pcall(function()
			if not (inst and inst.Parent and pr and pr.Parent) then
				return
			end
			local oldHold = pr.HoldDuration or 0
			pcall(function()
				pr.RequiresLineOfSight = false
			end)
			for attempt = 1, 3 do
				if not st.loot then
					break
				end
				if not (inst.Parent and pr.Parent) then
					break
				end
				if st.farm and #scanMobs(hrp) > 0 then
					break
				end
				local pos = promptPos(pr) or itemPos(inst)
				if not pos then
					break
				end
				local maxD = pr.MaxActivationDistance or 10
				if (hrp.Position - pos).Magnitude > maxD then
					break
				end
				pressE(oldHold + 0.8, pr)
				task.wait(0.3)
			end
		end)
		if not ok then
			print("[rathub-loot] error: " .. tostring(err))
		end
		lootBusy = false
		lootTarget = nil
		lootLastT = (inst and inst.Parent) and (now() + 1.0) or now()
	end)
end

local function lootRefresh(hrp)
	lootLastT = now()
	local range = st.lootRange
	for _, e in ipairs(listLoot(hrp)) do
		if e.dist <= range then
			lootTarget = e
			return true
		end
	end
	lootTarget = nil
	return false
end

local function lootStep(hrp, dt)
	if not st.loot then
		lootTarget = nil
		return false
	end
	local pr = lootTarget and lootTarget.prompt
	if lootBusy then
		local pos = lootTarget and (promptPos(lootTarget.prompt) or itemPos(lootTarget.inst))
		if pos then
			setPosFacing(hrp, pos, pos)
			return true
		end
		return false
	end
	if not lootTarget or not (pr and pr.Parent and pr.Enabled) then
		lootTarget = nil
		pr = nil
	end
	local pos = lootTarget and (promptPos(pr) or itemPos(lootTarget.inst))
	if lootTarget and pos then
		lootTarget.pos = pos
	end
	if not pos then
		if now() - lootLastT < st.lootDelay then
			return false
		end
		if not lootRefresh(hrp) then
			return false
		end
		pr = lootTarget.prompt
		pos = lootTarget.pos
	end
	local maxD = (pr and pr.MaxActivationDistance) or 10
	local standDist = math.min(3, math.max(maxD - 2, 1))
	if (hrp.Position - pos).Magnitude > standDist then
		moveToward(hrp, pos, pos, dt)
		return true
	end
	setPosFacing(hrp, pos, pos)
	lootPick(lootTarget, hrp)
	return true
end

