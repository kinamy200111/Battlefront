					angleInit = true
				end
				angle = angle + math.rad(st.orbitDeg) * dt
				local orb = fpos + Vector3.new(math.cos(angle) * st.radius, 0, math.sin(angle) * st.radius)
				setPosFacing(hrp, Vector3.new(orb.X, fpos.Y, orb.Z), fpos)
