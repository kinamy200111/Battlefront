						curTxt = tostring(items[curIdx].m or "?") .. "/" .. tostring(items[curIdx].target or "?")
					end
					st._pathStatus:SetText(string.format(
						"Path: %s (%s) | todo %d%s",
						tostring(cur ~= "" and cur or "?"),
						curTxt,
						todo,
						unknown > 0 and (" | unknown " .. unknown) or ""
					))
				end

				if st.pathBoostFarmEnabled then
					local cen = getCen()
					local itemsForBoost = lp:FindFirstChild("_Data") and lp._Data:FindFirstChild("Items")
					local boosters = 0
					if itemsForBoost then
						for _, c in ipairs(itemsForBoost:GetChildren()) do
							if c.Name:find("Booster X2 Mastery", 1, true) then
								boosters = boosters + (tonumber(c.Value) or 0)
							end
						end
					end
					local boostsData = lp:FindFirstChild("BoostsData")
					local boostSec = 0
					if boostsData then
						local bv = boostsData:FindFirstChild("BoostMastery")
						boostSec = tonumber(bv and bv.Value) or 0
					end
					if st.pathBoostFarmActive then
						if cen >= st.pathBoostFarmTarget then
							st.pathBoostFarmActive = false
							st.pathBoostFarmDone = true
							notify("Path", "boost farm done: " .. tostring(cen) .. " Cen", "check", 5)
						else
							st._pathForce(false)
							st.vote = true
							st.voteMode = "BossRush"
							st.farm = true
							st.titanFarm = false
							pcall(function()
								setToggle(farmToggle, true)
								setToggle(titanToggle, false)
							end)
							if canSwitch and cur ~= st.pathBoostFarmChar and t - lastSwitch >= 3 then
								lastSwitch = t
								switchCharacter(st.pathBoostFarmChar)
							end
							return
						end
					elseif not st.pathBoostFarmDone then
						if cen >= st.pathBoostFarmTarget then
							st.pathBoostFarmDone = true
						elseif boosters <= 0 and boostSec <= 0 then
							st.pathBoostFarmActive = true
							st.pathBoostFarmResume = curIdx > 0 and cur or nil
							st._pathForce(false)
							st.vote = true
							st.voteMode = "BossRush"
							st.farm = true
							st.titanFarm = false
							pcall(function()
								setToggle(farmToggle, true)
								setToggle(titanToggle, false)
							end)
							if canSwitch and cur ~= st.pathBoostFarmChar and t - lastSwitch >= 3 then
								lastSwitch = t
								switchCharacter(st.pathBoostFarmChar)
							end
							notify("Path", "no x2 Mastery -> BossRush Cen farm", "check", 5)
							return
						end
					elseif cen < st.pathBoostFarmResumeBelow then
						st.pathBoostFarmDone = false
					end
					if not st.pathBoostFarmActive and st.pathBoostFarmResume and canSwitch and cur ~= st.pathBoostFarmResume and t - lastSwitch >= 3 then
						lastSwitch = t
						if switchCharacter(st.pathBoostFarmResume) then
							st.pathBoostFarmResume = nil
						end
						return
					end
				end

				if st.pathFallbackActive then
					st._pathForce(false)
					st.vote = true
					st.voteMode = "BossRush"
					st.farm = true
					st.titanFarm = false
					pcall(function()
						setToggle(farmToggle, true)
						setToggle(titanToggle, false)
					end)
						if canSwitch and cur ~= st.pathFallbackChar and t - lastSwitch >= 3 then
						lastSwitch = t
						local okc = switchCharacter(st.pathFallbackChar)
						if not okc then
							notify("Path", "fallback switch failed: " .. st.pathFallbackChar, "triangle-alert", 4)
						end
					end
					return
				end

				if todo == 0 and unknown == 0 then
					if st.pathFallbackEnabled then
						st._pathForce(false)
						st.pathFallbackActive = true
						st.vote = true
						st.voteMode = "BossRush"
						st.farm = true
						st.titanFarm = false
						pcall(function()
							setToggle(farmToggle, true)
							setToggle(titanToggle, false)
						end)
					if canSwitch and cur ~= st.pathFallbackChar and t - lastSwitch >= 3 then
							lastSwitch = t
							switchCharacter(st.pathFallbackChar)
						end
						notify("Path", "list complete -> BossRush fallback", "check", 5)
						return
					end
					st.mastery = false
					st._pathForce(false)
					pcall(function()
						setToggle(masteryToggle, false)
					end)
					notify("Path", "path complete: all characters reached target", "check", 6)
					return
				end
				if todo == 0 then
					return
				end

				local curItem = curIdx > 0 and items[curIdx] or nil
				if curItem and (curItem.state == "todo" or curItem.state == "unknown") then
					return
				end

				local pick = nil
				if curIdx > 0 then
					for i = curIdx + 1, #items do
						if items[i].state == "todo" then
							pick = items[i]
							break
						end
					end
				end
				if not pick then
					for i = 1, #items do
						if items[i].state == "todo" then
							pick = items[i]
							break
						end
					end
				end
				if not pick or t - lastSwitch < 3 or not canSwitch then
					return
				end

				notify(
					"Path",
					(cur ~= "" and (cur .. " " .. tostring(curItem and curItem.m or "?") .. "/" .. tostring(curItem and curItem.target or "?") .. " -> ") or "")
						.. pick.name,
					"info",
					3
				)
				local switched = switchCharacter(pick.name)
				lastSwitch = now()
				if not switched then
					masterySkipped[pick.name] = true
					notify("Path", "could not switch to " .. pick.name, "triangle-alert", 4)
				elseif pick.name == "Upgraded Titan TV" and special then
					st._pathForce(true)
				elseif cur == "Upgraded Titan TV" then
					st._pathForce(false)
				end
			end)
			if not ok and t - lastErr > 5 then
				lastErr = t
				notify("Path", "error: " .. tostring(err):sub(1, 140), "triangle-alert", 5)
			end
		end
	end
end)

