	if not writefile then
		Party.lastError = "executor has no writefile"
		return false
	end
	Party.seq = Party.seq + 1
	data.seq = Party.seq
	data.updated = os.time()
	data.role = role
	data.name = lp.Name
	local ok, err = pcall(function()
		writefile(Party.statePath(role), Party.http:JSONEncode(data))
	end)
	if not ok then
		Party.lastError = tostring(err)
	end
	return ok
end

