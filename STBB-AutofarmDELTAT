local function titanPresetLists()
	local p = TITAN_PRESETS[st.titanPreset]
	if not p then
		return nil, nil
	end
	return p.weak, p.strong
end

local function titanIsFlyer(name)
	local low = tostring(name):lower()
	return low:find("helicopter", 1, true) ~= nil
		or low:find("helicoper", 1, true) ~= nil
		or low:find("jetpacktoilet", 1, true) ~= nil
end

local function titanHasItem()
	local ok, owned = pcall(function()
		local data = lp:FindFirstChild("_Data")
		local items = data and data:FindFirstChild("Items")
		local it = items and items:FindFirstChild(st.titanShopItem)
		if not it then
			return false
		end
		local n = tonumber(it.Value)
		return n == nil or n > 0
	end)
	if ok and owned then
		return true
	end
	-- fallback: tool in backpack / character
	local ok2, hasTool = pcall(function()
		local bp = lp:FindFirstChild("Backpack")
		if bp then
			for _, tool in ipairs(bp:GetChildren()) do
				if tool:IsA("Tool") and tool.Name:lower():find("titan", 1, true) then
					return true
				end
			end
		end
		local ch = lp.Character
		if ch then
			for _, tool in ipairs(ch:GetChildren()) do
				if tool:IsA("Tool") and tool.Name:lower():find("titan", 1, true) then
					return true
				end
			end
		end
		return false
	end)
	return ok2 and hasTool
end

local function titanMoney()
	-- the shop spends Data.MoneysInShop (round money), NOT lifetime _Data.Money
	local ok, v = pcall(function()
		local d = lp:FindFirstChild("Data")
		local m = d and d:FindFirstChild("MoneysInShop")
		local n = m and tonumber(m.Value)
		if n then
			return n
		end
		local data = lp:FindFirstChild("_Data")
		local money = data and data:FindFirstChild("Money")
		local mm = money and money:FindFirstChild("Moneys")
		return mm and tonumber(mm.Value)
	end)
	return (ok and v) or 0
end

task.spawn(function()
	while alive() do
		task.wait(0.5)
		if not (st.titanAutoRequest and st.titanFarm) then
			continue
		end
		if isTitanForm() or titanRequestUsed then
			continue
		end
		local wave = ws:FindFirstChild("Wave") and ws.Wave.Value or 0
		if wave == 0 then
			titanRequestUsed = false
			continue
		end

		if not titanHasItem() then
			-- the ShopSystem remote always works here: fire it whenever the
			-- shop is open, no money checks
			local t = now()
			if t - TS.buy < 2 then
				continue
			end
			if not canUseShop() then
				continue
			end
			local sandboxMode = rs:FindFirstChild("SandboxMode")
			local sandboxOn = sandboxMode and sandboxMode.Value == true
			if not sandboxOn and titanMoney() < (tonumber(st.titanPrice) or 2200) then
				continue
			end
			TS.buy = t
			-- silence everything from the buy onwards: the manual recipe is
			-- "farm off before buying the request"
			transformQuietUntil = now() + 10
			-- the Buy remote only works while standing at the shop helicopter
			shopHold = true
			pcall(function()
				local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
				if hrp then
					hrp.CFrame = CFrame.new(SHOP_POS.X, SHOP_POS.Y, SHOP_POS.Z)
					hrp.AssemblyLinearVelocity = Vector3.zero
				end
			end)
			task.wait(0.4)
			local rem = shopRemote()
			if not rem then
				shopHold = false
				continue
			end
			pcall(function()
				rem:FireServer("Buy", st.titanShopItem)
			end)
			print("[rathub-titan] buy sent (at shop): " .. st.titanShopItem)
			task.wait(1)
			shopHold = false
			if titanHasItem() then
				notify("Titan", st.titanShopItem .. " bought", "check", 3)
				print("[rathub-titan] purchase confirmed")
			end
			continue
		end

		-- item owned: use it WITHOUT remotes (RequestTitan is broken) -
		-- equip the item and LMB, fallback: click the slot in the inventory UI
		local t = now()
		if t - TS.use < 3 then
			continue
		end
		-- after a RequestTitan fire the transform takes a few seconds: do not
		-- equip / fire / click anything during that window, a second
		-- activation mid-transform bugs the titan
		if TS.reqFired > 0 and t - TS.reqFired < 8 then
			continue
		end
		TS.use = t
		-- keep / start the silence through equip + fire + transform
		if transformQuietUntil < now() + 40 then
			transformQuietUntil = now() + 40
		end
		print("[rathub-titan] item owned, equipping " .. st.titanShopItem)
		-- step 1: really put the item into the hands (exact name first)
		local pickedName = nil
		pcall(function()
			local bp = lp:FindFirstChild("Backpack")
			local ch = lp.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			local want = st.titanShopItem:lower()
			local function pick(container, strict)
				if not container then
					return nil
				end
				for _, tool in ipairs(container:GetChildren()) do
					if tool:IsA("Tool") then
						local n = tool.Name:lower()
						if strict then
							if n == want or n:find(want, 1, true) then
								return tool
							end
						elseif n:find("titan", 1, true) then
							return tool
						end
					end
				end
				return nil
			end
			local tool = pick(ch, true) or pick(bp, true) or pick(ch, false) or pick(bp, false)
			if not tool then
				return
			end
			pickedName = tool.Name
			if tool.Parent ~= ch and hum then
				hum:EquipTool(tool)
			end
		end)
		-- wait until the tool really sits in the Character (EquipTool may lag)
		local inHands = false
		for _ = 1, 30 do
			local ok, has = pcall(function()
				local ch = lp.Character
				if not ch or not pickedName then
					return false
				end
				return ch:FindFirstChild(pickedName) ~= nil
			end)
			if ok and has then
				inHands = true
				break
			end
			pcall(function()
				local ch = lp.Character
				local bp = lp:FindFirstChild("Backpack")
				local hum = ch and ch:FindFirstChildOfClass("Humanoid")
				local t = bp and pickedName and bp:FindFirstChild(pickedName)
				if t and hum then
					hum:EquipTool(t)
				end
			end)
			task.wait(0.15)
		end
		-- step 2: ONLY with the item in hands fire the remote
		if inHands then
			print("[rathub-titan] item in hands, firing RequestTitan")
			-- silence ALL loops from this moment: orbit / LMB / skills /
			-- clicks mid-transform bug the titan
			transformQuietUntil = now() + 30
			pcall(function()
				rs:WaitForChild(st.titanRequestRemote or "RequestTitan"):FireServer()
			end)
			TS.reqFired = now()
			-- wait for the form WITHOUT touching anything; only if the
			-- remote did not transform us after the quiet window the
			-- LMB fallback below may run
			for _ = 1, 60 do
				if isTitanForm() then
					break
				end
				if now() >= transformQuietUntil then
					break
				end
				task.wait(0.5)
			end
		else
			print("[rathub-titan] NOT in hands (" .. tostring(pickedName) .. "), remote skipped")
		end
		if isTitanForm() then
			titanRequestUsed = true
			notify("Titan", "titan form active", "check", 3)
			print("[rathub-titan] form active")
		elseif now() >= transformQuietUntil then
			-- remote did nothing and the quiet window is over: legacy
			-- LMB / inventory click fallback (form is still normal here)
			for _ = 1, 5 do
				if isTitanForm() then
					break
				end
				pcall(function()
					rs.LMB:FireServer()
				end)
				if type(mouse1click) == "function" then
					pcall(mouse1click)
				end
				task.wait(0.4)
			end
			if not isTitanForm() then
				pcall(function()
					local pg = lp:FindFirstChild("PlayerGui")
					local gui = pg and pg:FindFirstChild("003-A")
					local slot = gui and gui:FindFirstChild(st.titanShopItem, true)
					if slot then
						local btn = nil
						if slot:IsA("GuiButton") then
							btn = slot
						else
							for _, d in ipairs(slot:GetDescendants()) do
								if d:IsA("GuiButton") then
									btn = d
									break
								end
							end
						end
						if btn then
							clickGuiButton(btn)
							print("[rathub-titan] clicked inventory slot of " .. st.titanShopItem)
						end
					end
				end)
				task.wait(1.5)
			end
			if isTitanForm() then
				titanRequestUsed = true
				notify("Titan", "titan form active", "check", 3)
				print("[rathub-titan] form active")
			else
				print("[rathub-titan] use attempt failed, will retry")
			end
		else
			print("[rathub-titan] quiet wait ended without form, will retry")
		end
	end
end)

