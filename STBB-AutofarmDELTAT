function Party.loadConfig()
	if not (isfile and readfile) then
		return
	end
	pcall(function()
		local path = Party.configPath()
		if not isfile(path) then
			return
		end
		local data = Party.http:JSONDecode(readfile(path))
		if type(data) == "table" then
			Party.role = data.role or Party.role
			Party.id = data.id or Party.id
			Party.interval = tonumber(data.interval) or Party.interval
			Party.followVote = data.followVote ~= false
			Party.followChar = data.followChar == true
			Party.supportMode = data.supportMode
				or ((data.combatRole == "X18" or data.combatRole == "Clock Titan") and data.combatRole)
				or Party.supportMode
			Party.combatRole = data.combatRole or Party.combatRole
			Party.followLeader = data.followLeader == true
			Party.followDistance = tonumber(data.followDistance) or Party.followDistance
			Party.healBelow = tonumber(data.healBelow) or Party.healBelow
			Party.healList = data.healList or Party.healList
			if Party.supportMode ~= "X18" and Party.supportMode ~= "Clock Titan" then
				Party.combatRole = "None"
			else
				Party.combatRole = Party.supportMode
			end
			Party.clockDistance = tonumber(data.clockDistance) or Party.clockDistance
			if type(data.x18Anchor) == "table" then
				Party.x18Anchor = data.x18Anchor
			end
		end
	end)
end

