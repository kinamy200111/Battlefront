local function titanPickTarget(list)
	if #list == 0 then
		return nil
	end
	if Party.role == "Support" and Party.assistTarget and Party.assistTarget.name then
		for _, m in ipairs(list) do
			if m.name == Party.assistTarget.name then
				return m
			end
		end
	end
	local prioSrc = (st.titanPriority and st.titanPriority ~= "") and st.titanPriority or st.priority
	local prio = splitList(prioSrc)
	if #prio > 0 then
		local best = nil
		for _, m in ipairs(list) do
			local low = m.name:lower()
			for i = 1, #prio do
				if low:find(prio[i], 1, true) then
					if not best or m.dist < best.dist then
						best = m
					end
					break
				end
			end
		end
		if best then
			return best
		end
	end
	-- targets with 300+ max HP are priority over weaker ones
	local bestS, bestW = nil, nil
	for _, m in ipairs(list) do
		local strong = (m.mx or 0) >= 300
		if strong then
			if not bestS or m.dist < bestS.dist then
				bestS = m
			end
		else
			if not bestW or m.dist < bestW.dist then
				bestW = m
			end
		end
	end
	return bestS or bestW
end

local function titanGroundY(char, x, z, fromY)
	local y = nil
	pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local excl = { char }
		local living = ws:FindFirstChild("Living")
		if living then
			excl[#excl + 1] = living
		end
		params.FilterDescendantsInstances = excl
		local hit = workspace:Raycast(Vector3.new(x, fromY + 200, z), Vector3.new(0, -2000, 0), params)
		if hit then
			y = hit.Position.Y
		end
	end)
	return y
end

