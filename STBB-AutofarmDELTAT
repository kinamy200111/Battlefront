task.spawn(function()
	local base = nil
	while alive() do
		task.wait(1)
		if st.astro then
			local data = lp:FindFirstChild("_Data")
			local items = data and data:FindFirstChild("Items")
			local tok = items and items:FindFirstChild("Astro Token")
			if tok then
				local ok, val = pcall(function()
					return tok.Value
				end)
				if ok and val then
					if base == nil then
						base = val
					end
					local gained = math.floor(val - base)
					local txt = tostring(val) .. (gained > 0 and (" (+" .. tostring(gained) .. ")") or "")
					pcall(function()
						astroParagraph:SetText(txt)
					end)
				end
			end
		end
	end
end)

