					if TS.holdUntil and t < TS.holdUntil then
						return
					end
					local fired = false
					local listSize = 0
					local pickName = nil
					if dist > 22 then
						local function cdReady(name)
							local v = cdf and cdf:FindFirstChild(name)
							return not (v and v.Value == true)
						end
						local options = {}
						if cdReady("Shoot_Cooldown") then
							options[#options + 1] = "Shoot"
						end
						if st.utsmGatling then
							if cdReady("Galting_Cooldown") then
								options[#options + 1] = "Galting"
							end
						elseif cdReady("FifthShot_Cooldown") then
							options[#options + 1] = "FifthShot"
						end
						if cdReady("Core_Cooldown") then
							options[#options + 1] = "Core"
						end
						listSize = #options
						if #options > 0 then
							TS.utsmIdx = (TS.utsmIdx % #options) + 1
							local pick = options[TS.utsmIdx]
							pickName = pick
							if pick == "Shoot" then
								local rem = rs:FindFirstChild("UpgradedTitanSpeakerShoot")
								if rem then
									pcall(function()
										rem:FireServer()
									end)
								end
								TS.castUntil = t + 0.9
								fired = true
							elseif pick == "FifthShot" then
								local rem = rs:FindFirstChild("UpgradedTitanSpeakerFifthShot")
								if rem then
									pcall(function()
										rem:FireServer()
									end)
								end
								TS.castUntil = t + 0.9
								fired = true
							else
								local dur = tonumber(st.holdDuration) or 1.8
								if holdSkillRemote("UpgradedTitanSpeaker" .. pick, pick, dur) then
									TS.holdUntil = t + dur
									TS.castUntil = t + dur + 0.3
									fired = true
								end
							end
						end
					else
						local list = preset.melee
						listSize = #list
						local nextIdx, okFired, skill = runSkillNext(list, char, cdf, false, TS.sIdx)
						TS.sIdx = nextIdx
						if okFired then
							TS.castUntil = t + 0.9
							fired = true
							pickName = skill and skill.remote
						end
					end
					if t - titanSkillDebugAt > 10 then
						titanSkillDebugAt = t
						print(string.format(
							"[rathub-titan-skill] preset=UTSM dist=%.1f list=%d fired=%s pick=%s mode=%s gatling=%s",
							dist,
							listSize,
							tostring(fired),
							tostring(pickName),
							tostring(st.utsmMode),
							tostring(st.utsmGatling)
						))
					end
				else
				local weakL, strongL = titanPresetLists()
				local list = weakL and (((tgt.mx or 0) < 300) and weakL or strongL) or nil
				local fired = false
				if list then
					if t - titanSkillDebugAt > 10 then
						titanSkillDebugAt = t
						local missing = {}
						for _, s in ipairs(list) do
							if not resolveRemote(s.remote) then
								missing[#missing + 1] = s.remote
							end
						end
						print(string.format(
							"[rathub-titan-skill] preset=%s target=%s mx=%s orbiting=%s list=%d activeM1=%s missing=%s",
							tostring(st.titanPreset),
							tostring(tgt.name),
							tostring(tgt.mx),
							tostring(TS.orbiting),
							#list,
							tostring(am1 and am1.Value),
							table.concat(missing, ",")
						))
					end
					local nextIdx, okFired = runSkillNext(list, char, cdf, false, TS.sIdx)
					TS.sIdx = nextIdx
					fired = okFired
				else
					if not st._botBridge then
						local bm = rs:FindFirstChild("BotBridge")
						if bm then
							local okB, resB = pcall(require, bm)
							if okB then
								st._botBridge = resB
							end
						end
					end
					local profile = st._botBridge and st._botBridge.GetProfile()
					local actions = profile and profile.Actions
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					local targetPos = tgt.pos
					if not targetPos then
						for _, m in ipairs(TS.mobs or {}) do
							if m.name == tgt.name and m.root then
								targetPos = m.root.Position
								break
							end
						end
					end
					local dist = (targetPos and hrp) and (targetPos - hrp.Position).Magnitude or 999
					if actions then
						for _, action in ipairs(actions) do
							local range = action.Range or { 0, 100 }
							local minR = range[1] or 0
							local maxR = range[2] or 100
							if action.Fn and dist >= minR and dist <= maxR then
								local ready = true
								if action.Cooldown and cdf then
									local cd = cdf:FindFirstChild(action.Cooldown .. "_Cooldown")
									if cd and cd.Value == true then
										ready = false
									end
								end
								if ready and action.Ready then
									local okR, resR = pcall(action.Ready)
									if not okR or not resR then
										ready = false
									end
								end
								if ready then
									if action.Hold then
										local hold = action.HoldTime or 2
										TS.castUntil = t + hold + 0.3
										task.spawn(function()
											pcall(action.Fn)
											task.wait(hold)
											if action.Release then
												pcall(action.Release)
											end
										end)
									else
										TS.castUntil = t + 0.9
										pcall(action.Fn)
									end
									fired = true
									break
								end
							end
						end
					end
					if t - titanSkillDebugAt > 10 then
						titanSkillDebugAt = t
						print(string.format(
							"[rathub-titan-skill] preset=%s profile=%s actions=%d target=%s dist=%.1f fired=%s",
							tostring(st.titanPreset),
							tostring(profile and profile.Name),
							actions and #actions or 0,
							tostring(tgt.name),
							dist,
							tostring(fired)
						))
					end
				end
				if fired then
					TS.castUntil = t + 0.9
				end
				end
			end)
			if not ok and t - TS.err > 5 then
				TS.err = t
				print("[rathub-titan-skill] " .. tostring(err))
			end
		end
	end
end)

