task.spawn(function()
	local module
	while alive() do
		task.wait(0.4)
		if st.skillTreeAuto then
			if not module then
				local m = rs:FindFirstChild("SkillsTree")
				if m then
					local ok, res = pcall(require, m)
					if ok then
						module = res
					end
				end
			end
			if module then
				local pv = lp:FindFirstChild("PlayerValues")
				local ch = lp.Character
				local vf = ch and ch:FindFirstChild("ValuesFolder")
				local charName
				if vf and vf:FindFirstChild("UsingTitan") then
					charName = pv and pv:FindFirstChild("Titan") and pv.Titan.Value
				else
					charName = pv and pv:FindFirstChild("Character") and pv.Character.Value
				end
				local tree = charName and module.Tree(charName)
				local folder = lp:FindFirstChild("SkillTreesFolder")
				local data = lp:FindFirstChild("Data")
				local money = data and data:FindFirstChild("MoneysInShop")
				local rawCash = money and tostring(money.Value) or ""
				local cash = (rawCash:lower() == "inf") and math.huge or (tonumber(rawCash) or 0)
				local bought = nil
				if tree and folder then
					for skill, node in pairs(tree) do
						if not folder:FindFirstChild(skill) then
							local req = node[2]
							local reqOk = true
							if req then
								if type(req) == "table" then
									for _, r in ipairs(req) do
										if not folder:FindFirstChild(r) then
											reqOk = false
											break
										end
									end
								else
									reqOk = folder:FindFirstChild(req) ~= nil
								end
							end
							local price = node[3]
							if type(price) == "table" then
								price = price[1]
							end
							price = tonumber(price) or 0
							if reqOk and cash >= price then
								local rem = rs:FindFirstChild("SkillTrees")
								if rem then
									pcall(function()
										rem:FireServer(skill)
									end)
									bought = skill
								end
								break
							end
						end
					end
				end
				if st._skillTreeLabel then
					if not charName then
						st._skillTreeLabel:SetText("Skill Tree: no character")
					elseif not tree then
						st._skillTreeLabel:SetText("Skill Tree: no tree for " .. tostring(charName))
					elseif bought then
						st._skillTreeLabel:SetText("Skill Tree: buying " .. tostring(bought) .. " (" .. tostring(cash) .. " C)")
						task.wait(0.6)
					else
						st._skillTreeLabel:SetText("Skill Tree: no affordable nodes (" .. tostring(cash) .. " C)")
					end
				end
			end
		end
	end
end)

