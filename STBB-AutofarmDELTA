local function getOwnedSkins()
	local owned = {}
	pcall(function()
		local data = lp:FindFirstChild("_Data")
		local skins = data and data:FindFirstChild("Skins")
		if skins then
			for _, v in ipairs(skins:GetChildren()) do
				owned[v.Name] = true
			end
		end
	end)
	return owned
end

local function getAllSkinKeys()
	local keys = {}
	pcall(function()
		local sf = rs:FindFirstChild("SkinFolders")
		if sf then
			for _, m in ipairs(sf:GetChildren()) do
				keys[#keys + 1] = m.Name
			end
		end
	end)
	return keys
end

local function findMissingSkins(wanted)
	local owned = getOwnedSkins()
	local missing = {}
	if wanted and #wanted > 0 then
		for _, k in ipairs(wanted) do
			if not owned[k] then
				missing[#missing + 1] = k
			end
		end
	else
		local all = getAllSkinKeys()
		for _, k in ipairs(all) do
			if not owned[k] then
				missing[#missing + 1] = k
			end
		end
	end
	return missing
end

local function getBannerSkins()
	local out = {}
	pcall(function()
