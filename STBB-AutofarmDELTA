local function parseAstroPoints(text)
	if type(text) ~= "string" or text == "" then
		return nil
	end
	local out = {}
	for line in text:gmatch("[^\r\n]+") do
		local a, b, c = line:match("Vector3%.new%(%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*%)")
		if not a then
			a, b, c = line:match("^%s*([%-%d%.]+)%s+([%-%d%.]+)%s+([%-%d%.]+)%s*$")
		end
		if a then
			out[#out + 1] = Vector3.new(tonumber(a), tonumber(b), tonumber(c))
		end
	end
	if #out == 0 then
		return nil
	end
	return out
end

local function astroRoutePoints()
	local custom = parseAstroPoints(st.astroPointsText)
	if custom then
		return custom
	end
	return ASTRO_POINTS
end

