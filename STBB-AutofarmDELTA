local function splitList(s)
	local out = {}
	for part in tostring(s or ""):gmatch("[^,;]+") do
		local p = part:gsub("^%s+", ""):gsub("%s+$", "")
		if p ~= "" then
			out[#out + 1] = p:lower()
		end
	end
	return out
end

local function parseVec3(s)
	local x, y, z = tostring(s or ""):match("([%-%d%.]+)%s*[ ,;]+([%-%d%.]+)%s*[ ,;]+([%-%d%.]+)")
	if x and y and z then
		return Vector3.new(tonumber(x), tonumber(y), tonumber(z))
	end
	return nil
end

local function waveInList(wave)
	for _, p in ipairs(splitList(st.waveList)) do
		if tonumber(p) == wave then
			return true
		end
	end
	return false
end

-- Skill config line: "Remote | Cooldown | RequireChild | arg1,arg2"
--   Remote       required, name (or dotted path) under ReplicatedStorage
--   Cooldown     optional bool in CooldownFolder; skip while Value == true
--   RequireChild optional child that must exist on the character
--   args         optional comma-separated arguments passed to FireServer
local function resolveRemote(path)
	if not path or path == "" then
		return nil
	end
	local cur = rs
	for seg in tostring(path):gmatch("[^%.]+") do
		if not cur then
			return nil
		end
		cur = cur:FindFirstChild(seg)
	end
	return cur
end

local function parseSkillList(text)
	local out = {}
	for line in tostring(text or ""):gmatch("[^\r\n]+") do
		local cleaned = line:gsub("^%s+", ""):gsub("%s+$", "")
		if cleaned ~= "" and cleaned:sub(1, 1) ~= "#" then
			local parts = {}
			for p in (cleaned .. "|"):gmatch("([^|]*)|") do
				parts[#parts + 1] = p:gsub("^%s+", ""):gsub("%s+$", "")
			end
			local name = parts[1]
			if name and name ~= "" then
				local args = {}
				if parts[4] and parts[4] ~= "" then
					for a in parts[4]:gmatch("[^,]+") do
						a = a:gsub("^%s+", ""):gsub("%s+$", "")
						if a ~= "" then
							args[#args + 1] = tonumber(a) or a
						end
					end
				end
				out[#out + 1] = {
					remote = name,
					cooldown = (parts[2] and parts[2] ~= "") and parts[2] or nil,
					require = (parts[3] and parts[3] ~= "") and parts[3] or nil,
					args = args,
				}
			end
		end
	end
	return out
end

local function runSkillList(list, char, cdf, busy)
	for _, s in ipairs(list) do
		local rem = resolveRemote(s.remote)
		if rem then
			local ok = not busy
			if ok and s.cooldown then
				local cd = cdf and cdf:FindFirstChild(s.cooldown)
				if cd and cd.Value == true then
					ok = false
				end
			end
			if ok and s.require and not char:FindFirstChild(s.require) then
				ok = false
			end
			if ok then
				pcall(function()
					rem:FireServer(table.unpack(s.args))
				end)
			end
		end
	end
end

local function yawTo(pos, at)
	return math.atan2(-(at.X - pos.X), -(at.Z - pos.Z))
end

-- writes the position and kills the residual velocity, otherwise the
-- character keeps falling for a frame and bounces up/down between writes
local function setPosFacing(hrp, pos, facePos)
	hrp.CFrame = CFrame.new(pos.X, pos.Y, pos.Z) * CFrame.Angles(0, yawTo(pos, facePos), 0)
	pcall(function()
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end)
end

local function moveToward(hrp, goal, facePos, dt)
	local dist = (goal - hrp.Position).Magnitude
	if dist <= 0.75 then
		if (goal - facePos).Magnitude > 1 then
			setPosFacing(hrp, goal, facePos)
		else
			local yaw = math.atan2(-hrp.CFrame.LookVector.X, -hrp.CFrame.LookVector.Z)
			hrp.CFrame = CFrame.new(goal.X, goal.Y, goal.Z) * CFrame.Angles(0, yaw, 0)
		end
		return true
	end
	local step = st.speed * dt
	local newPos
	if step >= dist then
		newPos = goal
	else
		newPos = hrp.Position + (goal - hrp.Position).Unit * step
	end
	setPosFacing(hrp, newPos, facePos)
	return newPos == goal
end

