local VOTE_PAGES = {
	{ "Normal", "Hard", "VeryHard", "Insane", "Nightmare" },
	{ "BossRush", "ThunderStorm", "Zombie", "Christmas", "Hell" },
	{ "DarkDimension", "Astro", "AstroV2", "ZombieV2" },
}
local VOTE_MODE_SET = {}
for _, pg in ipairs(VOTE_PAGES) do
	for _, m in ipairs(pg) do
		VOTE_MODE_SET[m] = true
	end
end
VOTE_MODE_SET["NoLightInTheSky"] = true
VOTE_MODE_SET["Custom"] = true
VOTE_MODE_SET["100MVisit"] = true

local function voteRemote()
	return rs:FindFirstChild("Vote")
end
local function readyRemote()
	return rs:FindFirstChild("GetReadyRemote")
end
local function autoReadyZone()
	return ws:FindFirstChild("AutoReady")
end

local function currentVote()
	local v = ws:FindFirstChild("Vote")
	if not v then
		return nil
	end
	for _, mode in ipairs(v:GetChildren()) do
		if VOTE_MODE_SET[mode.Name] and #mode:GetChildren() > 0 then
			return mode.Name
		end
	end
	return nil
end

local function fireVote(mode)
	local r = voteRemote()
	if not r then
		return false
	end
	return (pcall(function()
		r:FireServer(mode)
	end))
end

local function chooseSlot()
	local slot = st.readySlot
	if slot == "Auto" then
		slot = nil
		local cg = lp.PlayerGui and lp.PlayerGui:FindFirstChild("ChrGUI")
		if cg then
			for i = 1, 3 do
				local bv = cg:FindFirstChild("GetReady" .. i)
				if bv then
					local ok, v = pcall(function()
						return bv.Value
					end)
					if ok and v == true then
						slot = tostring(i)
					end
				end
			end
		end
		if not slot then
			slot = "3"
		end
	end
	return slot
end

local function fireReady()
	local r = readyRemote()
	if not r then
		return false
	end
	local slot = chooseSlot()
	return (pcall(function()
		r:FireServer(slot, true)
	end))
end

local function isNotReady()
	local pg = lp.PlayerGui
	local sc = pg and pg:FindFirstChild("SelectCharacter")
	local main = sc and sc:FindFirstChild("Main")
	local l = main and main:FindFirstChild("JustText3")
	if not l then
		return nil
	end
	local ok, t = pcall(function()
		return l.Text
	end)
	if not ok or not t then
		return nil
	end
	return t:lower():find("not ready", 1, true) ~= nil
end

local function hoverReadyZone()
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	local ar = autoReadyZone()
	if not root or not ar then
		return false
	end
	local p = ar.Position
	local s = ar.Size
	root.CFrame = CFrame.new(p.X, p.Y + s.Y / 2, p.Z)
	return true
end

task.spawn(function()
	local lastVote = 0
	local lastReady = 0
	local lastReadyFire = 0
	local votedPhase = false
	local phaseStart = 0
	local lastErr = 0
	local READY_VOTE_DELAY = 10

	while alive() do
		task.wait(0.4)
		if st.vote or st.ready then
			local t = now()
			local ok, err = pcall(function()
				local votingNow = ws:FindFirstChild("Voteing") and ws.Voteing.Value == true
				local wave = ws:FindFirstChild("Wave") and ws.Wave.Value or 0

				if votingNow then
					if phaseStart == 0 then
						phaseStart = t
					end
				else
					phaseStart = 0
					votedPhase = false
				end
				if wave > 0 then
					votedPhase = false
				end

				-- VOTE (remote)
				if st.vote and votingNow then
					local mine = currentVote()
					if mine == st.voteMode then
						votedPhase = true
					elseif not votedPhase or (t - lastVote > 20) then
						lastVote = t
						if fireVote(st.voteMode) then
