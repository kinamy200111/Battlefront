				-- READY (remote)
				local readyBlocked = votingNow and not votedPhase
				if (votingNow or (ws:FindFirstChild("OpenVoteUI") ~= nil)) and phaseStart > 0 then
					if (t - phaseStart) < READY_VOTE_DELAY and not votedPhase then
						readyBlocked = true
					end
				end
				if st.ready and not readyBlocked and wave == 0 then
					local nr = isNotReady()
					if nr ~= false then
						if st.readyHover and t - lastReady > 1.5 then
							lastReady = t
							hoverReadyZone()
