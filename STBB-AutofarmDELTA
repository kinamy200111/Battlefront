-- FARM MAIN LOOP
-- ============================================================
local lastNamesT = 0
local lastScanT = 0
local lastLmbT = 0
local lastErrT = 0

RunService.Heartbeat:Connect(function(dt)
	if not alive() or not (st.farm or st.loot) then
		return
	end
	local ok, err = pcall(function()
		local char = lp.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end
		if hrp ~= lastHrp then
			lastHrp = hrp
			angleInit = false
		end

		if godBusy then
			return
		end

		-- the astro route owns the character: nothing else may write CFrame
		-- (loot/idle movement here would fight the route and cause the bounce)
		if st.astro then
			return
		end

		-- loot can run on its own (farm off): only pick gears up
		if not st.farm then
			lootStep(hrp, dt)
			return
		end

		local wave = ws:FindFirstChild("Wave") and ws.Wave.Value or 0
		if st.resetWave then
			if wave == st.resetWaveNum and not resetDone then
				hrp.CFrame = CFrame.new(hrp.Position.X, -175, hrp.Position.Z)
				resetDone = true
				print("[rathub] reset: under map (wave " .. tostring(wave) .. ")")
				return
			elseif wave ~= st.resetWaveNum then
				resetDone = false
			end
		end

		local t = now()
		if t - lastNamesT >= 1 then
			lastNamesT = t
			refreshPlayerNames()
		end
		if t - lastScanT >= 0.5 then
			lastScanT = t
			mobs = scanMobs(hrp)
		end

		local target = pickTarget(mobs)
		if not target then
			currentTarget = nil
			isOrbiting = false
			if lootStep(hrp, dt) then
				-- looting owns movement
			elseif zoneGoal then
				if moveToward(hrp, zoneGoal, zoneGoal, dt) then
					zoneGoal = nil
				end
			elseif st.idleVec and wave > 0 then
				moveToward(hrp, st.idleVec, st.idleVec, dt)
			end
			return
		end
		if not currentTarget or currentTarget.mob ~= target.mob then
			currentTarget = target
			angleInit = false
			if isPriorityName(target.name) then
				notify("Farm", "target: " .. target.name, "crosshair", 2)
			end
		end

		if st.m1 and t - lastLmbT >= 0.1 then
			lastLmbT = t
			local cdf = lp.Character and lp.Character:FindFirstChild("CooldownFolder")
			local am1 = cdf and cdf:FindFirstChild("ActiveM1")
			local lb = cdf and cdf:FindFirstChild("LMBActive")
			if not ((am1 and am1.Value == true) or (lb and lb.Value == true)) then
				fireLMB()
			end
		end

		local tpos
		pcall(function()
			tpos = target.root.Position
		end)
		if not tpos then
			tpos = target.pos
		end
		target.pos = tpos
		local ppos = hrp.Position
		local flatT = Vector3.new(tpos.X, ppos.Y, tpos.Z)
		local dist = (flatT - ppos).Magnitude

		local fakeBoss = (st.fakeBoss and st.fakeBoss ~= "") and st.fakeBoss:lower() or nil
		local isCargo = fakeBoss ~= nil and target.name:lower():find(fakeBoss, 1, true) ~= nil
		if isCargo and target.fake and target.fake.Parent then
			local fpos = target.fake.Position
			local flatH = Vector3.new(fpos.X, ppos.Y, fpos.Z)
			local fDist = (flatH - ppos).Magnitude
			if fDist > st.radius + 3 then
				isOrbiting = false
				if math.abs(ppos.Y - fpos.Y) > 2 then
					moveToward(hrp, Vector3.new(ppos.X, fpos.Y, ppos.Z), fpos, dt)
				else
					local dir = (ppos - flatH).Unit
					local goal = flatH + dir * st.radius
					moveToward(hrp, Vector3.new(goal.X, fpos.Y, goal.Z), fpos, dt)
				end
			else
				isOrbiting = true
				if not angleInit then
					local off = ppos - fpos
					angle = math.atan2(off.Z, off.X)
					angleInit = true
				end
				angle = angle + math.rad(st.orbitDeg) * dt
				local orb = fpos + Vector3.new(math.cos(angle) * st.radius, 0, math.sin(angle) * st.radius)
				setPosFacing(hrp, Vector3.new(orb.X, fpos.Y, orb.Z), fpos)
			end
		elseif st.orbit then
			if dist > st.radius + 3 then
				isOrbiting = false
				local dir = (ppos - flatT).Unit
				local goal = flatT + dir * st.radius
				goal = Vector3.new(goal.X, tpos.Y, goal.Z)
				if st.tween then
					moveToward(hrp, goal, tpos, dt)
				else
					setPosFacing(hrp, goal, tpos)
				end
			else
				isOrbiting = true
				if not angleInit then
					local off = ppos - tpos
					angle = math.atan2(off.Z, off.X)
					angleInit = true
				end
				angle = angle + math.rad(st.orbitDeg) * dt
				local orb = tpos + Vector3.new(math.cos(angle) * st.radius, 0, math.sin(angle) * st.radius)
				setPosFacing(hrp, Vector3.new(orb.X, tpos.Y, orb.Z), tpos)
			end
		elseif st.tween and dist > 6 then
			isOrbiting = false
			moveToward(hrp, tpos, tpos, dt)
		else
			isOrbiting = false
		end
	end)
	if not ok then
		local t = now()
		if t - lastErrT > 5 then
			lastErrT = t
			print("[rathub-farm] " .. tostring(err))
		end
	end
end)

