local function multiNames(v)
	if type(v) == "table" then
		local out = {}
		for _, x in ipairs(v) do
			local s = tostring(x)
			if s ~= "" then
				out[#out + 1] = s
			end
		end
		return out
	end
	if v ~= nil and tostring(v) ~= "" then
		return { tostring(v) }
	end
	return {}
end

