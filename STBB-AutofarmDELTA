local HttpService = game:GetService("HttpService")

local function webhookFields()
	local d = lp:FindFirstChild("_Data")
	local fields = {}
	local function add(name, value, inline)
		if value ~= nil and tostring(value) ~= "" then
			fields[#fields + 1] = {
				name = tostring(name),
				value = tostring(value):sub(1, 1024),
				inline = inline ~= false,
			}
		end
	end

	local cv = d and d:FindFirstChild("Character")
	local charName = cv and cv.Value or "?"
	add("Character", charName)
	add("Mastery", masteryOf(charName) or "", true)

	local wv = ws:FindFirstChild("Wave")
	local tw = ws:FindFirstChild("TimerWave")
	add("Wave", wv and tostring(wv.Value) or "?", true)
	add("Timer", tw and tostring(math.floor(tw.Value)) .. "s" or "?", true)

	local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		add("HP", math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth or 0), true)
	end

	local money = d and d:FindFirstChild("Money") and d.Money:FindFirstChild("Moneys")
	if money then
		add("Money", tostring(money.Value), true)
	end

	local items = d and d:FindFirstChild("Items")
	if items then
		local t = {}
		for _, c in ipairs(items:GetChildren()) do
			local n = tonumber(c.Value)
			t[#t + 1] = c.Name .. (n and (" x" .. n) or "")
		end
		add("Inventory", table.concat(t, "\n"))
	end
	return fields
end

sendWebhook = function(quiet)
	local url = tostring(st.webhookUrl or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if url == "" or not url:match("^https://") then
		if not quiet then
			notify("Webhook", "set a valid https:// URL first", "triangle-alert", 4)
		end
		return false
	end
	local payload = {
		username = "RATHUB Blockade",
		embeds = {
			{
				title = "Blockade status",
				color = 3447003,
				fields = webhookFields(),
				timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
			},
		},
	}
	local body = HttpService:JSONEncode(payload)
	local req = request or http_request
	if not req then
		notify("Webhook", "executor has no request()", "triangle-alert", 4)
		return false
	end
	local ok, res = pcall(function()
		return req({
			Url = url,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = body,
		})
	end)
	if not ok then
		if not quiet then
			notify("Webhook", "send failed: " .. tostring(res):sub(1, 120), "triangle-alert", 4)
		end
		return false
	end
	local code = type(res) == "table" and tonumber(res.StatusCode) or nil
	if code and code >= 300 then
		if not quiet then
			notify("Webhook", "HTTP " .. tostring(code), "triangle-alert", 4)
		end
		return false
	end
	if not quiet then
		notify("Webhook", "sent", "check", 2)
	end
	return true
end

task.spawn(function()
