local ShopRem
local function shopRemote()
	if not ShopRem or not ShopRem.Parent then
		ShopRem = rs:FindFirstChild("ShopSystem")
	end
	return ShopRem
end

local function buyFillHP()
	local rem = shopRemote()
	if not rem then
		return false
	end
	local ok = pcall(function()
		rem:FireServer("Buy", "FillHP")
	end)
	return ok
end

local function hpNow()
	local hum = lp.Character and lp.Character:FindFirstChild("Humanoid")
	return hum and hum.Health or 0
end

-- The shop window (workspace.CanUseShop) opens for a short time while the
-- helicopter is at the pad, so Buy/FillHP is spammed for the whole attempt
-- instead of a few quick shots: the buy lands the moment the window opens.
-- No teleport: the character stays wherever the farm left it.
local function doHeal()
	if not shopRemote() then
		print("[rathub-heal] ReplicatedStorage.ShopSystem missing")
		return false
	end
	local before = hpNow()
	local t0 = now()
	local shots = 0
	local limit = math.max(tonumber(st.healTry) or 12, 3)
	while alive() and now() - t0 < limit do
		if buyFillHP() then
			shots = shots + 1
		end
		task.wait(0.18)
		local hp = hpNow()
		if hp > before + 1 then
			print(string.format("[rathub-heal] healed %d -> %d (%d shots, %.1fs)", before, hp, shots, now() - t0))
			return true
		end
	end
	print(string.format("[rathub-heal] no heal after %d shots (%.0fs, CanUseShop=%s)", shots, now() - t0, tostring(canUseShop())))
	return false
end

