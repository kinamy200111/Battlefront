-- executor request first (Delta/Madium/Synapse variants), then HttpGet.
-- Delta quirks: request may return a bare string, use lowercase `body`,
-- or only expose syn.request; HttpGet may be disabled in Delta settings.
local function httpGet(url)
	local candidates = {}
	if type(request) == "function" then
		candidates[#candidates + 1] = request
	end
	if type(http_request) == "function" then
		candidates[#candidates + 1] = http_request
	end
	if type(syn) == "table" and type(syn.request) == "function" then
		candidates[#candidates + 1] = syn.request
	end
	for _, req in ipairs(candidates) do
		local ok, res = pcall(function()
			return req({ Url = url, Method = "GET" })
		end)
		if ok then
			if type(res) == "string" and res ~= "" then
				return res
			end
			if type(res) == "table" then
				local body = res.Body or res.body
				if type(body) == "string" and body ~= "" then
					return body
				end
			end
		end
	end
	local ok2, body = pcall(function()
		return game:HttpGet(url)
	end)
	if ok2 and type(body) == "string" and body ~= "" then
		return body
	end
	return nil
end

