-- ----------------------------------------------------------
-- 1) WindUI downloads its icon sets from raw.githubusercontent.com,
--    which stalls on networks where GitHub raw is blocked -> mirror
--    every icon URL onto jsDelivr (identical files).
-- ----------------------------------------------------------
local ICON_RAW = "https://raw.githubusercontent.com/Footagesus/Icons/refs/heads/main/"
local ICON_CDN = "https://cdn.jsdelivr.net/gh/Footagesus/Icons@main/"
windBody = windBody:gsub(ICON_RAW, ICON_CDN)

-- ----------------------------------------------------------
-- 2) Redirect WindUI's HTTP through our own fetch (executor request).
