RunService.Heartbeat:Connect(function(dt)
	if not alive() or not st.titanFarm then
		return
	end
	if not isTitanForm() then
		if TS.wasForm then
			-- the form was active and is now gone (died / round ended):
			-- only now it is safe to lift the silence and reset flags
			TS.wasForm = false
			transformQuietUntil = 0
			titanRequestUsed = false
		end
		if st.titanFarm and not TS.hint then
			TS.hint = true
			notify("Titan", "normal character farm until the request is bought and used", "info", 3)
		end
		return
	end
	TS.hint = false
	TS.wasForm = true
	local t = now()
	local ok, err = pcall(function()
		local char = lp.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end
		local wave = ws:FindFirstChild("Wave") and ws.Wave.Value or 0
		-- reset wave (titan side, the normal farm heartbeat returns here)
		if st.titanResetWave and st.titanResetWave > 0 then
			if wave >= st.titanResetWave and not TS.resetDone then
				hrp.CFrame = CFrame.new(hrp.Position.X, -175, hrp.Position.Z)
				TS.resetDone = true
				print("[rathub-titan] reset: under map (wave " .. tostring(wave) .. ")")
				return
			elseif wave < st.titanResetWave then
				TS.resetDone = false
			end
		end
		-- M1 spams all the time, together with abilities
		if st.titanM1 and t - TS.lmb >= 0.1 then
			TS.lmb = t
			local cdf = char:FindFirstChild("CooldownFolder")
			local am1 = cdf and cdf:FindFirstChild("ActiveM1")
			local lb = cdf and cdf:FindFirstChild("LMBActive")
			if not ((am1 and am1.Value == true) or (lb and lb.Value == true)) then
				pcall(function()
					rs.LMB:FireServer()
				end)
			end
		end

		if t - TS.scan >= 0.5 then
			TS.scan = t
			TS.mobs = scanMobs(hrp)
		end
		local target = titanPickTarget(TS.mobs)
		if not target then
			-- no enemies: stay in one position (like the normal farm)
			TS.target = nil
			TS.orbiting = false
			TS.angleInit = false
			return
		end
		TS.target = { name = target.name, mx = target.mx }
		local tpos
		pcall(function()
			tpos = target.root.Position
		end)
		if not tpos then
			tpos = target.pos
		end
		target.pos = tpos
		local ppos = hrp.Position
		local flatT = Vector3.new(tpos.X, ppos.Y, tpos.Z)
		local dist = (flatT - ppos).Magnitude

		if dist > st.titanRadius + 3 then
			-- approach: stay at orbit radius, feet on the ground
			TS.angleInit = false
			TS.orbiting = false
			local dir = Vector3.new(ppos.X - flatT.X, 0, ppos.Z - flatT.Z)
			if dir.Magnitude < 0.01 then
				dir = Vector3.new(0, 0, 1)
			end
			dir = dir.Unit
			local goal = flatT + dir * st.titanRadius
			local step = math.min(st.titanSpeed * dt, math.max(dist - st.titanRadius, 0))
			local flat = Vector3.new(goal.X, ppos.Y, goal.Z)
			local toGoal = flat - ppos
			local np = ppos + (toGoal.Magnitude > 0.01 and toGoal.Unit * math.min(step, toGoal.Magnitude) or Vector3.new(0, 0, 0))
			local gy = titanGroundY(char, np.X, np.Z, ppos.Y)
			local y = (gy or TS.lastY or ppos.Y) + st.titanFeetOffset
			TS.lastY = y
			setPosFacing(hrp, Vector3.new(np.X, y, np.Z), tpos)
		else
			-- orbit the target on the ground
			TS.orbiting = true
			if not TS.angleInit then
				local off = ppos - flatT
				TS.angle = math.atan2(off.Z, off.X)
				TS.angleInit = true
			end
			TS.angle = TS.angle + math.rad(st.titanOrbitDeg) * dt
			local orb = tpos + Vector3.new(math.cos(TS.angle) * st.titanRadius, 0, math.sin(TS.angle) * st.titanRadius)
			local gy = titanGroundY(char, orb.X, orb.Z, ppos.Y)
			local y = (gy or TS.lastY or ppos.Y) + st.titanFeetOffset
			TS.lastY = y
			setPosFacing(hrp, Vector3.new(orb.X, y, orb.Z), tpos)
		end
	end)
	if not ok and t - TS.err > 5 then
		TS.err = t
		print("[rathub-titan] " .. tostring(err))
	end
end)

local function parseMasteryList(text)
	local out = {}
	for line in (text or ""):gmatch("[^\r\n]+") do
		line = line:gsub("^%s+", ""):gsub("%s+$", "")
		if line ~= "" and line:sub(1, 1) ~= "#" then
			local name, cap = line:match("^(.-)%s*|%s*(%d+)%s*$")
			if name and name ~= "" then
				out[#out + 1] = { name = name, cap = tonumber(cap) }
			else
				out[#out + 1] = { name = line, cap = nil }
			end
		end
	end
	return out
end

local function dataFolder()
	return lp:FindFirstChild("_Data")
end

local function masteryOf(name)
	local d = dataFolder()
	local f = d and d:FindFirstChild("Mastery")
	if not f then
		return nil
	end
	local v = f:FindFirstChild(name .. ":Mastery")
	if not v then
		for _, c in ipairs(f:GetChildren()) do
			if c.Name:gsub(":Mastery$", "") == name then
				v = c
				break
			end
		end
	end
	if not v then
		return nil
	end
	local n = tostring(v.Value):match("^(%-?%d+)")
	return n and tonumber(n) or nil
end

local function isUnlocked(name)
	local d = dataFolder()
	local u = d and d:FindFirstChild("UnlockedCharacter")
	if not u then
		return true
	end
	return u:FindFirstChild(name) ~= nil
end

local function switchCharacter(name)
	local d = dataFolder()
	local cv = d and d:FindFirstChild("Character")
	if not cv then
		return false
	end
	if cv.Value == name then
		return true
	end
	local rem = rs:FindFirstChild("ForChangeCharacter")
	if not rem then
		return false
	end
	pcall(function()
		rem:FireServer(name, 0)
	end)
	for _ = 1, 24 do
		task.wait(0.25)
		if cv.Value == name then
			return true
		end
	end
	return false
end

task.spawn(function()
	local lastErr = 0
	local lastSwitch = 0
	while alive() do
		task.wait(st.masteryDelay)
		if st.mastery and now() >= transformQuietUntil and not isTitanForm() then
			local t = now()
			local ok, err = pcall(function()
				local d = dataFolder()
				local cv = d and d:FindFirstChild("Character")
				if not cv then
					return
				end
				local list = parseMasteryList(st.masteryList)
				if #list == 0 then
					return
				end
				local cur = cv.Value
				local items = {}
				local curIdx = 0
				local todo, unknown = 0, 0
				for i, e in ipairs(list) do
					local target = e.cap or st.masteryDefault
					local m = masteryOf(e.name)
					local state
					if masterySkipped[e.name] or not isUnlocked(e.name) then
						state = "skip"
					elseif m == nil then
						state = "unknown"
						unknown = unknown + 1
					elseif m >= target then
						state = "done"
					else
						state = "todo"
						todo = todo + 1
					end
					items[i] = { name = e.name, target = target, m = m, state = state }
					if e.name == cur then
						curIdx = i
					end
				end

				if todo == 0 and unknown == 0 then
					st.mastery = false
					pcall(function()
						setToggle(masteryToggle, false)
					end)
					notify("Mastery", "path complete: all characters reached target", "check", 6)
					return
				end
				if todo == 0 then
					return
				end

				local curItem = curIdx > 0 and items[curIdx] or nil
				if curItem and (curItem.state == "todo" or curItem.state == "unknown") then
					return
				end

				local pick = nil
				if curIdx > 0 then
					for i = curIdx + 1, #items do
						if items[i].state == "todo" then
							pick = items[i]
							break
						end
					end
				end
				if not pick then
					for i = 1, #items do
						if items[i].state == "todo" then
							pick = items[i]
							break
						end
					end
				end
				if not pick or t - lastSwitch < 3 then
					return
				end

				notify(
					"Mastery",
					(cur ~= "" and (cur .. " " .. tostring(curItem and curItem.m or "?") .. "/" .. tostring(curItem and curItem.target or "?") .. " -> ") or "")
						.. pick.name,
					"info",
					3
				)
				local switched = switchCharacter(pick.name)
				lastSwitch = now()
				if not switched then
					masterySkipped[pick.name] = true
					notify("Mastery", "could not switch to " .. pick.name, "triangle-alert", 4)
				end
			end)
			if not ok and t - lastErr > 5 then
				lastErr = t
				notify("Mastery", "error: " .. tostring(err):sub(1, 140), "triangle-alert", 5)
			end
		end
	end
end)

