local function parseMasteryList(text)
	local out = {}
	for line in (text or ""):gmatch("[^\r\n]+") do
		line = line:gsub("^%s+", ""):gsub("%s+$", "")
		if line ~= "" and line:sub(1, 1) ~= "#" then
			local name, cap = line:match("^(.-)%s*|%s*(%d+)%s*$")
			if name and name ~= "" then
				out[#out + 1] = { name = name, cap = tonumber(cap) }
			else
				out[#out + 1] = { name = line, cap = nil }
			end
		end
	end
	return out
end

local function dataFolder()
	return lp:FindFirstChild("_Data")
end

local function masteryOf(name)
	local d = dataFolder()
	local f = d and d:FindFirstChild("Mastery")
	if not f then
		return nil
	end
	local v = f:FindFirstChild(name .. ":Mastery")
	if not v then
		for _, c in ipairs(f:GetChildren()) do
			if c.Name:gsub(":Mastery$", "") == name then
				v = c
				break
			end
		end
	end
	if not v then
		return nil
	end
	local n = tostring(v.Value):match("^(%-?%d+)")
	return n and tonumber(n) or nil
end

local function isUnlocked(name)
	local d = dataFolder()
	local u = d and d:FindFirstChild("UnlockedCharacter")
	if not u then
		return true
	end
	return u:FindFirstChild(name) ~= nil
end

local function switchCharacter(name)
	local d = dataFolder()
	local cv = d and d:FindFirstChild("Character")
	if not cv then
		return false
	end
	if cv.Value == name then
		return true
	end
	local rem = rs:FindFirstChild("ForChangeCharacter")
	if not rem then
		return false
	end
	pcall(function()
		rem:FireServer(name, 0)
	end)
	for _ = 1, 24 do
		task.wait(0.25)
		if cv.Value == name then
			return true
		end
	end
	return false
end

task.spawn(function()
	local lastErr = 0
	local lastSwitch = 0
	while alive() do
		task.wait(st.masteryDelay)
		if st.mastery then
			local t = now()
			local ok, err = pcall(function()
				local d = dataFolder()
				local cv = d and d:FindFirstChild("Character")
				if not cv then
					return
				end
				local list = parseMasteryList(st.masteryList)
				if #list == 0 then
					return
				end
				local cur = cv.Value
				local items = {}
				local curIdx = 0
				local todo, unknown = 0, 0
				for i, e in ipairs(list) do
					local target = e.cap or st.masteryDefault
					local m = masteryOf(e.name)
					local state
					if masterySkipped[e.name] or not isUnlocked(e.name) then
						state = "skip"
					elseif m == nil then
						state = "unknown"
						unknown = unknown + 1
					elseif m >= target then
						state = "done"
					else
						state = "todo"
						todo = todo + 1
					end
					items[i] = { name = e.name, target = target, m = m, state = state }
					if e.name == cur then
						curIdx = i
					end
				end

				if todo == 0 and unknown == 0 then
					st.mastery = false
					pcall(function()
						setToggle(masteryToggle, false)
					end)
					notify("Mastery", "path complete: all characters reached target", "check", 6)
					return
				end
				if todo == 0 then
					return
				end

				local curItem = curIdx > 0 and items[curIdx] or nil
				if curItem and (curItem.state == "todo" or curItem.state == "unknown") then
					return
				end

				local pick = nil
				if curIdx > 0 then
					for i = curIdx + 1, #items do
						if items[i].state == "todo" then
							pick = items[i]
							break
						end
					end
				end
				if not pick then
					for i = 1, #items do
						if items[i].state == "todo" then
							pick = items[i]
							break
						end
					end
				end
				if not pick or t - lastSwitch < 3 then
					return
				end

				notify(
					"Mastery",
					(cur ~= "" and (cur .. " " .. tostring(curItem and curItem.m or "?") .. "/" .. tostring(curItem and curItem.target or "?") .. " -> ") or "")
						.. pick.name,
					"info",
					3
				)
				local switched = switchCharacter(pick.name)
				lastSwitch = now()
				if not switched then
					masterySkipped[pick.name] = true
					notify("Mastery", "could not switch to " .. pick.name, "triangle-alert", 4)
				end
			end)
			if not ok and t - lastErr > 5 then
				lastErr = t
				notify("Mastery", "error: " .. tostring(err):sub(1, 140), "triangle-alert", 5)
			end
		end
	end
end)

-- ============================================================
-- GOD MODE (forced respawn before death)
--   Humanoid.Health / Player:LoadCharacter are server side only,
--   so the character is dropped below FallenPartsDestroyHeight and
--   the server kills it (verified: death in ~2-3s, then respawn).
-- ============================================================
local godLastT = 0
local lastErrGod = 0
task.spawn(function()
	while alive() do
		task.wait(0.25)
		if st.god and not godBusy then
			local t = now()
			local ok, err = pcall(function()
				local char = lp.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if not hum or not hum.Parent then
					return
				end
				local hp, mx = hum.Health, hum.MaxHealth or 0
				if mx <= 0 then
					return
				end
				-- a threshold above the max HP makes no sense (it would reset on
				-- every hit), so half of the max HP is used in that case
				local limit = st.godHP >= mx and (mx * 0.5) or st.godHP
				if not (hp < limit and hp < mx) then
					return
				end
				local tw = ws:FindFirstChild("TimerWave")
				if st.godSkipTimer0 and tw and tw.Value <= 0 then
					return
				end
				if t - godLastT < 3 then
					return
				end
				godLastT = t
				godBusy = true
				local hrp = char:FindFirstChild("HumanoidRootPart")
				if hrp then
					-- dropped above the destroy height: the body has to fall
					-- through it (a placement below it gets rescued, not killed)
					local killY = (ws.FallenPartsDestroyHeight or -1000) + 300
					hrp.CFrame = CFrame.new(hrp.Position.X, killY, hrp.Position.Z)
				end
				notify("God", "reset before death (hp " .. math.floor(hp) .. ")", "info", 3)
				-- phase 1: wait for the kill (max ~6s)
				for _ = 1, 24 do
					task.wait(0.25)
					local c = lp.Character
					local h = c and c:FindFirstChildOfClass("Humanoid")
					local r = c and c:FindFirstChild("HumanoidRootPart")
					if not h or h.Health <= 0 or not r then
						break
					end
				end
				-- phase 2: wait until the body is usable again (respawn takes
				-- the game's RespawnTime, 20s here, so allow ~25s)
				for _ = 1, 100 do
					task.wait(0.25)
					local c = lp.Character
					local h = c and c:FindFirstChildOfClass("Humanoid")
					local r = c and c:FindFirstChild("HumanoidRootPart")
					if h and r and h.Health > 0 then
						break
					end
				end
				task.wait(0.4)
				godBusy = false
			end)
			if not ok and t - lastErrGod > 5 then
				lastErrGod = t
				notify("God", "error: " .. tostring(err):sub(1, 120), "triangle-alert", 4)
			end
		end
	end
end)

