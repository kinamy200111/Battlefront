-- movement runs on Heartbeat (once per rendered frame) with a dt-based step:
-- the old 0.05s timer wrote the position less often than physics pulled the
-- character down, which showed up as the up/down bounce at every waypoint
local idx = 1
local teleported = false
local lastHeal = 0
local lastErrA = 0

RunService.Heartbeat:Connect(function(dt)
	if not alive() or not st.astro then
		return
	end
	local t = now()
	local ok, err = pcall(function()
		local char = lp.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end
		if godBusy then
			return
		end

		local tw = ws:FindFirstChild("TimerWave")
		local timeLeft = tw and tw.Value or -1
		local wave = ws:FindFirstChild("Wave") and ws.Wave.Value or 0
		if wave <= 0 then
			return
		end

		if teleported then
			if timeLeft > 100 then
				teleported = false
				idx = 1
				print("[rathub] new round, flying again")
			end
			return
		end

		if timeLeft <= 0 then
			local goal = st.idleVec
			if goal then
				setPosFacing(hrp, goal, goal)
				print("[rathub] timer 0, teleported to circle")
				notify("Astro", "timer 0: standing on circle", "check", 3)
			end
			teleported = true
			return
		end

		if st.astroHeal and t - lastHeal > 1 then
			local hum = char:FindFirstChild("Humanoid")
			if hum then
				local hp, mx = hum.Health, hum.MaxHealth
				if mx > 0 and hp / mx <= 0.5 then
					local okB = pcall(function()
						rs.Buff:FireServer()
					end)
					if not okB then
						pcall(function()
							VIM:SendKeyEvent(true, Enum.KeyCode.Y, false, lp)
						end)
						task.wait(0.05)
						pcall(function()
							VIM:SendKeyEvent(false, Enum.KeyCode.Y, false, lp)
						end)
					end
					lastHeal = t
					print("[rathub] astro heal, hp " .. math.floor(hp) .. "/" .. math.floor(mx))
				end
			end
		end

		local goal = ASTRO_POINTS[idx]
		local pos = hrp.Position
		local dist = (goal - pos).Magnitude
		if dist <= 3 then
			idx = idx % #ASTRO_POINTS + 1
			goal = ASTRO_POINTS[idx]
			dist = (goal - pos).Magnitude
		end
		local step = math.min(st.astroSpeed * dt, dist)
		local np = pos + (goal - pos).Unit * step
		setPosFacing(hrp, np, goal)
	end)
	if not ok and t - lastErrA > 5 then
		lastErrA = t
		print("[rathub-astro] " .. tostring(err))
	end
end)

