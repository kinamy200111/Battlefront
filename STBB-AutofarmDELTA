local LOOT_SCAN_NODES = 40000
local LOOT_SCAN_TIME = 0.025

local lootCache = {}
local lootScanRound = 0

local function promptPos(pr)
	local par = pr.Parent
	if not par then
		return nil
	end
	if par:IsA("BasePart") then
		return par.Position
	end
	if par:IsA("Attachment") then
		local ok, p = pcall(function()
			return par.WorldPosition
		end)
		if ok then
			return p
		end
	end
	return itemPos(par)
end

local function promptOwner(pr)
	local p = pr
	for _ = 1, 6 do
		p = p.Parent
		if not p or p == ws then
			break
		end
		if isGearName(p.Name) then
			return p
		end
	end
	return nil
end

local function listLoot(hrp)
	if next(gearKeys) == nil then
		refreshGearNames()
	end
	local ppos = hrp.Position
	local nodes = LOOT_SCAN_NODES
	local deadline = os.clock() + LOOT_SCAN_TIME
	local complete = true
	local found = {}
	local seen = {}

	local function consider(inst, pr)
		if seen[inst] then
			return
		end
		seen[inst] = true
		if not (pr and pr.Parent and pr.Enabled) then
			return
		end
		local pos = promptPos(pr) or itemPos(inst)
		if not pos then
			return
		end
		found[inst] = { inst = inst, prompt = pr, pos = pos, dist = (ppos - pos).Magnitude }
	end

	local function walk(container, rotate)
		local kids = container:GetChildren()
		local n = #kids
		local first = 1
		if rotate and n > 1 then
			lootScanRound = lootScanRound + 1
			first = (lootScanRound % n) + 1
		end
		for i = 1, n do
			if not complete then
				return
			end
			local idx = first + i - 1
			if idx > n then
				idx = idx - n
			end
			local w = kids[idx]
			if nodes <= 0 or os.clock() > deadline then
				complete = false
				return
			end
			nodes = nodes - 1
			if w:IsA("ProximityPrompt") then
				local owner = promptOwner(w)
				if owner then
					consider(owner, w)
				end
			elseif isGearName(w.Name) then
				local pr = itemPrompt(w)
				if pr then
					consider(w, pr)
				end
			end
			if not w:IsA("ProximityPrompt") and #w:GetChildren() > 0 then
				walk(w, false)
			end
		end
	end
	walk(ws, true)

	for inst, e in pairs(lootCache) do
		if not found[inst] and inst.Parent and e.prompt and e.prompt.Parent then
			local pos = promptPos(e.prompt) or itemPos(inst)
			if pos then
				found[inst] = { inst = inst, prompt = e.prompt, pos = pos, dist = (ppos - pos).Magnitude }
			end
		end
	end
	lootCache = found

	local out = {}
	for _, e in pairs(found) do
		out[#out + 1] = e
	end
	table.sort(out, function(a, b)
		return a.dist < b.dist
	end)
	return out
end

local function pressE(hold, prompt)
	local h = math.max(tonumber(hold) or 0.2, 0.15)
	if prompt then
		local okB = pcall(function()
			prompt:InputHoldBegin()
		end)
		if okB then
			task.wait(h)
			pcall(function()
				prompt:InputHoldEnd()
			end)
			task.wait(0.25)
			return
		end
	end
	if VIM then
		pcall(function()
			VIM:SendKeyEvent(true, Enum.KeyCode.E, false, lp)
		end)
		task.wait(h)
		pcall(function()
			VIM:SendKeyEvent(false, Enum.KeyCode.E, false, lp)
		end)
	end
	task.wait(0.25)
end

