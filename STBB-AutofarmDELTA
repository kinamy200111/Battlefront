local windCache = {}
local windReq = request or http_request or (type(syn) == "table" and syn.request) or nil
local function windHttpGet(url)
	if type(url) ~= "string" then
		return ""
	end
	local hit = windCache[url]
	if hit then
		return hit
	end
	if windReq and url:sub(1, #ICON_CDN) == ICON_CDN then
		local ok, res = pcall(function()
			return windReq({ Url = url, Method = "GET" })
		end)
		local body = nil
		if ok and type(res) == "string" then
			body = res
		elseif ok and type(res) == "table" then
			body = res.Body or res.body
		end
		if type(body) == "string" and body ~= "" then
			-- only hand back something that can actually be parsed as Lua,
			-- otherwise return "" so WindUI falls back to bundled icons
			if not body:find("<html", 1, true) and body:find("return", 1, true) then
				windCache[url] = body
				return body
			end
		end
	end
	return ""
end

