local function ele(parent, name, opts)
	if not parent then
		return nil
	end
	local ok, obj = pcall(function()
		return parent[name](parent, opts)
	end)
	if not ok then
		warn("[RATHUB] UI " .. tostring(name) .. " failed: " .. tostring(obj))
		return nil
	end
	return obj
end

