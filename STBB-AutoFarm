local function readReadyButton(cg)
    local fr = cg:FindFirstChild("Frame-Ready")
    local menu = fr and fr:FindFirstChild("Menu")
    local rdy = menu and menu:FindFirstChild("Ready")
    local btn = rdy and rdy:FindFirstChild("Button")
    local text = "?"
    if btn then
        local lab = btn:FindFirstChildOfClass("TextLabel")
        if lab then
            pcall(function() text = lab.Text end)
        end
    end
    local vis = false
    local sx, sy = 0, 0
    if btn then
        local okS, sX, sY = pcall(function()
            local s = btn.AbsoluteSize
            return s.X, s.Y
        end)
        vis = okS and sX > 0 and sY > 0
        sx, sy = sX or 0, sY or 0
    end
    return btn, text, vis, sx, sy
end

-- статус готовности по надписи SelectCharacter > Main > JustText3
local function isNotReady()
    local pg = lp.PlayerGui
    local sc = pg and pg:FindFirstChild("SelectCharacter")
    local main = sc and sc:FindFirstChild("Main")
    local l = main and main:FindFirstChild("JustText3")
    if not l then return nil end
    local ok, t = pcall(function() return l.Text end)
    if not ok or not t then return nil end
    return t:lower():find("not ready", 1, true) ~= nil
end

-- телепорт на верхнюю точку AutoReady — игрок падает вниз прямо на зону
local function hoverTarget()
    local ar2 = ws:FindFirstChild("AutoReady")
    if not ar2 then return nil end
    return Vector3.new(ar2.Position.X, ar2.Position.Y + ar2.Size.Y / 2, ar2.Position.Z)
end
local function startHover()
    local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    local target = hoverTarget()
    if not root or not target then return false end
    root.CFrame = CFrame.new(target.X, target.Y, target.Z)
    return true
end

