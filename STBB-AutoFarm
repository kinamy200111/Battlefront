local ALLY_PREFIX = {"villanarc", "blaster tank", "cam turret", "attacker drone", "missile rocket", "[ ai ]", "[ai", "camera", "skibidifriend", "speaker pulse tank"}
local playerNames = {}

local function refreshPlayerNames()
