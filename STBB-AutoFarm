    { "BossRush", "ThunderStorm", "Zombie", "Christmas", "Hell" },
    { "DarkDimension", "Astro", "AstroV2", "ZombieV2" },
}
local VOTE_MODE_SET = {}
for _, pg in ipairs(VOTE_PAGES) do
    for _, m in ipairs(pg) do VOTE_MODE_SET[m] = true end
end

local voteCurPage = nil
local function voteLog(msg) print("[farm-vote] " .. msg) end

local function voteGui()
    local pg = lp and lp.PlayerGui
    return pg and pg:FindFirstChild("Play")
end
local function voteMain()
    local play = voteGui()
    return play and play:FindFirstChild("Main")
end
local function voteCenter(inst)
    local x, y = nil, nil
    local ok = pcall(function()
        local ap = inst.AbsolutePosition
        local as = inst.AbsoluteSize
        x, y = ap.X + as.X / 2, ap.Y + as.Y / 2
    end)
    if ok and x and y and x > 0 and y > 0 then return x, y end
    return nil
end
local function voteSoundCount(kind)
    local n = 0
    for _, c in ipairs(ws:GetChildren()) do
        if c.ClassName == "Sound" and c.Name == kind then n = n + 1 end
    end
    return n
end
local function voteClick(inst, kind)
    local x, y = voteCenter(inst)
    if not x then return false end
    local before = voteSoundCount(kind)
    mousemoveabs(x, y)
    task.wait(0.05)
    for i = 1, 4 do
        mousemoverel(i % 2 == 0 and 2 or -2, i % 2 == 0 and -1 or 1)
        task.wait(0.02)
    end
    mousemoveabs(x, y)
    task.wait(0.05)
    mouse1click()
    task.wait(0.4)
    return voteSoundCount(kind) > before
end
local function voteClickRetry(inst, tries, label, kind)
    for i = 1, tries do
        if voteClick(inst, kind) then return true end
        task.wait(0.3)
    end
    voteLog(label .. " click failed after " .. tries .. " tries")
    return false
end
local function voteClickNav(dir)
    local main = voteMain()
    local b = main and main:FindFirstChild(dir > 0 and "Next" or "Previous")
    if not b then return false end
    for i = 1, 3 do
        local ox, oy, osx, osy = nil, nil, nil, nil
        pcall(function()
            local ap = b.AbsolutePosition
            local as = b.AbsoluteSize
            ox, oy, osx, osy = ap.X, ap.Y, as.X, as.Y
        end)
        local cx, cy = nil, nil
        if ox and oy and osx and osy and osx > 0 and osy > 0 then
            cx, cy = ox + osx / 2, oy + osy / 2
        end
        local before = voteSoundCount("ui4")
        if cx then
            local nsx, nsy = math.max(osx, 300), math.max(osy, 90)
            local enlarged = pcall(function()
                b.AbsoluteSize = Vector2.new(nsx, nsy)
                b.AbsolutePosition = Vector2.new(cx - nsx / 2, cy - nsy / 2)
            end)
            task.wait(0.1)
            mousemoveabs(cx, cy)
            task.wait(0.05)
            for j = 1, 4 do
                mousemoverel(j % 2 == 0 and 2 or -2, j % 2 == 0 and -1 or 1)
                task.wait(0.02)
            end
            mousemoveabs(cx, cy)
            task.wait(0.05)
            mouse1click()
            task.wait(0.4)
            if enlarged then
                pcall(function()
                    b.AbsoluteSize = Vector2.new(osx, osy)
                    b.AbsolutePosition = Vector2.new(ox, oy)
                end)
            end
        else
            task.wait(0.3)
        end
        if voteSoundCount("ui4") > before then
            task.wait(0.6)
            return true
        end
        task.wait(0.3)
    end
    return false
end
local function voteOpenPlay()
    local pg = lp and lp.PlayerGui
    local ov = pg and pg:FindFirstChild("OpenVoteUI")
    local ob = ov and ov:FindFirstChild("OPEN UI")
    if not ob then return false end
    local ok = voteClick(ob)
    task.wait(0.6)
    return ok
end
local function voteMyVotedMode()
    local v = ws:FindFirstChild("Vote")
    if not v then return nil end
    for _, mode in ipairs(v:GetChildren()) do
        if VOTE_MODE_SET[mode.Name] and #mode:GetChildren() > 0 then
            return mode.Name
        end
    end
    return nil
end
local function voteNormalize()
    local main = voteMain()
    if not main then return nil end
    for _ = 1, 3 do
        if not voteClickNav(-1) then break end
    end
    if voteClickNav(-1) then
        voteLog("sync: Previous still sounds after 3 back-clicks, GUI broken?")
        return nil
    end
    voteCurPage = 1
    return true
end
local function voteGotoPage(target)
    if voteCurPage == nil then
        local ok = voteNormalize()
        if not ok then return false end
    end
    if target < voteCurPage then
        voteLog("target " .. target .. " < cur " .. voteCurPage .. ", re-sync")
        voteCurPage = nil
        local ok = voteNormalize()
        if not ok then return false end
        if target < voteCurPage then return false end
    end
    local diff = target - voteCurPage
    for _ = 1, diff do
        if not voteClickNav(1) then
            voteLog("Next failed on page " .. voteCurPage)
            voteCurPage = nil
            return false
        end
        voteCurPage = voteCurPage + 1
    end
    return true
end
local function votePageOf(name)
    for i, pg in ipairs(VOTE_PAGES) do
        for _, m in ipairs(pg) do
            if m == name then return i end
        end
    end
    return nil
end
local function voteSelectMode(name)
    local p = votePageOf(name)
    if not p then
        voteLog("unknown mode " .. name)
        return false
    end
    if not voteGotoPage(p) then
        voteLog("failed to reach page " .. p .. " for " .. name)
        return false
    end
    local main = voteMain()
    local b = main and main:FindFirstChild(name)
    if not b then
        voteLog("mode button missing: " .. name)
        return false
    end
    for i = 1, 3 do
        if voteClickRetry(b, 2, "mode:" .. name, "ui4") then
            return true
        end
        task.wait(0.3)
    end
    voteLog("could not click mode " .. name)
    return false
end
local function voteDoVote(mode)
    voteCurPage = nil
    for attempt = 1, 3 do
        local mine = voteMyVotedMode()
        if mine == mode then return true end
        if mine then voteLog("voted for " .. mine .. ", switching to " .. mode) end
        if voteSelectMode(mode) then
            local main = voteMain()
            local vb = main and main:FindFirstChild("VoteButton")
            if vb and voteClickRetry(vb, 3, "VoteButton", "ui2") then
                local wrong = false
                for _ = 1, 4 do
                    task.wait(0.5)
                    mine = voteMyVotedMode()
                    if mine == mode then return true end
                    if mine and mine ~= mode then
                        wrong = true
                        break
                    end
                end
                if wrong then
                    voteLog("voted WRONG mode " .. mine .. ", page was off — re-sync")
                else
                    voteLog("vote click fired but folder not updated, retry")
                end
            else
                voteLog("VoteButton click NOT registered")
            end
        end
        voteCurPage = nil
        local ok = voteNormalize()
        if not ok then
            if not voteOpenPlay() then
                task.wait(1.0)
            end
        end
    end
    return false
end


