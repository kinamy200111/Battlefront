    local lastReady = 0
    local votedLobby = false
    local lastErr = 0
    local lastBugFixT = 0
    local bugFixActive = false
    local votePhaseStart = 0
    local READY_VOTE_DELAY = 10
    while alive() do
        task.wait(0.4)
        if st.vote or st.ready then
        local now = tick()
        local ok, err = pcall(function()
            local votingNow = ws.Voteing and ws.Voteing.Value == true
            local wave = ws.Wave and ws.Wave.Value or 0


            if votingNow then
                if votePhaseStart == 0 then votePhaseStart = now end
            else
                votePhaseStart = 0
            end

            if st.vote and votingNow and (not votedLobby or now - lastVote > 30) then
                lastVote = now
                local okV
                if st.voteMethod == "Hybrid" then
                    okV = pcall(function() rs.Vote:FireServer(st.voteMode) end)
                else
                    okV = voteDoVote(st.voteMode)
                end
                if okV then
                    votedLobby = true
                    Notify("Farm", "voted " .. st.voteMode .. " (" .. (st.voteMethod == "Hybrid" and "remote" or "clicks") .. ")", 2, "success")
                    print("[farm] voted " .. st.voteMode)
                else
                    Notify("Farm", "vote click failed: " .. st.voteMode, 2, "warning")
                    print("[farm] vote click failed: " .. st.voteMode)
                end
            end
            if wave > 0 then votedLobby = false end

            local voteGUIOpen = voteGui() ~= nil
            local readyBlocked = (votingNow or voteGUIOpen) and not (votedLobby or voteMyVotedMode())
            if (votingNow or voteGUIOpen) and votePhaseStart > 0 and now - votePhaseStart < READY_VOTE_DELAY then
                readyBlocked = true
            end
            if st.ready and not readyBlocked and (votingNow or wave == 0) and now - lastReady > 1.5 then
                local method = st.readyMethod
                if method ~= "GUI (button)" then
                    local ar2 = ws:FindFirstChild("AutoReady")
                    local char = lp.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if root and not bugFixActive then
                        zoneGoal = nil
                        bugFixActive = true
                        lastBugFixT = now
                        startHover()
                    end
                end

                if method ~= "Zone (TP)" then
                    local cg = lp.PlayerGui and lp.PlayerGui:FindFirstChild("ChrGUI")
                    if cg then
                        local btn, btnText, vis, sx, sy = readReadyButton(cg)
                        if btnText ~= "READY" then
                            if not vis then
                                pressComma()
                                task.wait(0.8)
                                btn, btnText, vis, sx, sy = readReadyButton(cg)
                            end
                            local slot = nil
                            for i = 1, 3 do
                                local bv = cg:FindFirstChild("GetReady" .. i)
                                if bv then
                                    pcall(function() if bv.Value == true then slot = tostring(i) end end)
                                end
                            end
                            if not slot then slot = "3" end
                            pcall(function() rs.GetReadyRemote:FireServer(slot, true) end)
                            for i = 1, 3 do
                                local bv = cg:FindFirstChild("GetReady" .. i)
                                if bv then
                                    pcall(function() bv.Value = true end)
                                end
                            end
                            if vis and btn and sx > 0 and sy > 0 then
                                local posOk, px, py = pcall(function()
                                    local p = btn.AbsolutePosition
                                    return p.X, p.Y
                                end)
                                if posOk then
                                    mousemoveabs(px + sx / 2, py + sy / 2)
                                    task.wait(0.1)
                                    mouse1click()
                                    task.wait(0.4)
                                    print("[farm] ready clicked")
                                end
                            end
                            pressComma()
                            print("[farm] ready sent (slot " .. slot .. ")")
                            Notify("Farm", "ready (slot " .. slot .. ")", 2, "success")
                        else
                            if vis then pressComma() end
                        end
                    end
                end
                lastReady = now
            end


            if st.ready and not readyBlocked and (votingNow or wave == 0) then
                local nr = isNotReady()
                if nr == false then
                    bugFixActive = false
                end

                if bugFixActive and now - lastBugFixT >= 30 then
                    lastBugFixT = now
                    local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                    local target = hoverTarget()
                    if root and target then
                        root.CFrame = CFrame.new(target.X, target.Y, target.Z)
                        print("[farm] zone bug fix: re-teleport")
                    end
                end
            else
                bugFixActive = false
            end
        end)
        if not ok and now - lastErr > 5 then
            lastErr = now
            print("[farm-lobby] " .. tostring(err))
        end
        end
    end
end)


local function gotoShop()
    local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    root.CFrame = CFrame.new(SHOP_POS.X, SHOP_POS.Y, SHOP_POS.Z)
    return true
end


local function healButton()
    local pg = lp and lp.PlayerGui
    local a3 = pg and pg:FindFirstChild("003-A")
    local main = a3 and a3:FindFirstChild("Main")
    return main and main:FindFirstChild("Heal")
end


local function clickHeal()
    local btn = healButton()
    if not btn then
        print("[farm-heal] Heal button not found")
        return false
    end
    local hum = lp.Character and lp.Character:FindFirstChild("Humanoid")
    local before = hum and hum.Health or 0

    local ox, oy, osx, osy = nil, nil, nil, nil
    pcall(function()
        local ap = btn.AbsolutePosition
        local as = btn.AbsoluteSize
        ox, oy, osx, osy = ap.X, ap.Y, as.X, as.Y
    end)
    local cx, cy = nil, nil
    if ox and oy and osx and osy and osx > 0 and osy > 0 then
        cx, cy = ox + osx / 2, oy + osy / 2
    end
    if not cx then return false end

    local nsx, nsy = math.max(osx, 300), math.max(osy, 90)
    local enlarged = pcall(function()
        btn.AbsoluteSize = Vector2.new(nsx, nsy)
        btn.AbsolutePosition = Vector2.new(cx - nsx / 2, cy - nsy / 2)
    end)
    task.wait(0.1)
    mousemoveabs(cx, cy)
    task.wait(0.05)
    for i = 1, 4 do
        mousemoverel(i % 2 == 0 and 2 or -2, i % 2 == 0 and -1 or 1)
        task.wait(0.02)
    end
    mousemoveabs(cx, cy)
    task.wait(0.05)
    mouse1click()
    task.wait(1.0)
    if enlarged then
        pcall(function()
            btn.AbsoluteSize = Vector2.new(osx, osy)
            btn.AbsolutePosition = Vector2.new(ox, oy)
        end)
    end
    hum = lp.Character and lp.Character:FindFirstChild("Humanoid")
    local after = hum and hum.Health or 0
    if after > before + 1 then
        print("[farm-heal] healed " .. math.floor(before) .. " -> " .. math.floor(after))
        return true
    end
    return false
end

local function canUseShop()
    local cus = ws:FindFirstChild("CanUseShop")
    if not cus then return false end
    local okC, v = pcall(function() return cus.Value end)
    return okC and v == true
end

local function doHeal()

    if not gotoShop() then return false end
    print("[farm-heal] at shop, waiting 8s for landing...")
    task.wait(8)


    local guiWait = tick()
    while alive() do
        local btn = healButton()
        if btn then break end
        if tick() - guiWait > 10 then
            print("[farm-heal] shop GUI timeout")
            return false
        end
        task.wait(0.3)
    end

    for i = 1, 3 do
        if clickHeal() then
            return true
        end
        task.wait(0.5)
    end
    print("[farm-heal] heal click NOT registered")
    return false
end

task.spawn(function()
    while alive() do
        task.wait(0.5)
        if st.heal and st.on then
            local now = tick()
            local hum = lp.Character and lp.Character:FindFirstChild("Humanoid")
            if hum then
                local hp, mx = hum.Health, hum.MaxHealth

                local needHeal = healRequested or (mx > 0 and hp / mx * 100 < st.healHP)
