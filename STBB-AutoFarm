    end
end)


local function pressKeys(list)
    for _, k in ipairs(splitList(list)) do
        local kk = k:lower()
        if kk == "m1" or kk == "lmb" then
            mouse1click()
        else
            local u = k:upper()
            local vk = #u == 1 and u:byte() or nil
            if vk then
                keypress(vk)
                task.wait(0.03)
                keyrelease(vk)
            end
        end
        task.wait(0.03)
    end
end

