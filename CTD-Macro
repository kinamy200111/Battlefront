local function findDisconnectPrompt()
	local promptGui = game:GetService("CoreGui"):FindFirstChild("RobloxPromptGui")
	local overlay = promptGui and promptGui:FindFirstChild("promptOverlay")
	if not overlay then return nil end
	local ep = overlay:FindFirstChild("ErrorPrompt")
	if ep and ep.Visible then return ep end
	for _, ch in ipairs(overlay:GetChildren()) do
		if ch:IsA("GuiObject") and ch.Visible and ch.Name:lower():find("error") then
			return ch
		end
	end
	return nil
end

local function clickDisconnectButton(prompt)
	local best
	for _, d in ipairs(prompt:GetDescendants()) do
		if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.Visible then
			local n = d.Name:lower()
			local t = (d:IsA("TextButton") and d.Text or ""):lower()
			if n:find("reconnect") or t:find("reconnect") or t:find("retry") or t:find("try again") then
				best = d
				break
			end
		end
	end
	if not best then
		for _, d in ipairs(prompt:GetDescendants()) do
			if d:IsA("TextButton") and d.Visible then
				local t = (d.Text or ""):lower()
				if not t:find("leave") and not d.Name:lower():find("leave") then
					best = d
					break
				end
			end
		end
	end
	if not best then return false end
	if type(firesignal) == "function" then
		if pcall(firesignal, best.Activated) then return true end
	end
	pcall(function() best:FireSignal("Activated") end)
	return true
end

local reconnectThread
function Macro.SetAutoReconnect(enabled)
	Macro.AutoReconnect = enabled and true or false
	Macro.Settings.AutoReconnect = Macro.AutoReconnect
	saveConfig()
	if reconnectThread then pcall(task.cancel, reconnectThread); reconnectThread = nil end
	if Macro.AutoReconnect then
		reconnectThread = track(function()
			local lastClick = 0
			while Macro.AutoReconnect do
				pcall(function()
					local ep = findDisconnectPrompt()
					if ep and os.clock() - lastClick > 12 then
						lastClick = os.clock()
						if clickDisconnectButton(ep) then
							print("[Macro] Обнаружен дисконнект — кликаю Reconnect")
						end
					end
				end)
				task.wait(2)
			end
		end)
		print("[Macro] AutoReconnect = true")
	end
end

