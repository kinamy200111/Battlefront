-- ========== Запись ==========

local function serializeArg(a)
	local t = typeof(a)
	if t == "CFrame" then return { _type = "CFrame", components = { a:GetComponents() } }
	elseif t == "Vector3" then return { _type = "Vector3", x = a.X, y = a.Y, z = a.Z }
	elseif t == "table" then
		local out = {}
		for k, v in pairs(a) do out[k] = serializeArg(v) end
		return out
	elseif t == "string" or t == "number" or t == "boolean" then return a
	else return tostring(a) end
end

local function deserializeArg(a)
	if type(a) ~= "table" then return a end
	if a._type == "CFrame" then return CFrame.new(unpack(a.components))
	elseif a._type == "Vector3" then return Vector3.new(a.x, a.y, a.z)
	else
		local out = {}
		for k, v in pairs(a) do out[k] = deserializeArg(v) end
		return out
	end
end

-- ========== Очередь построек ==========

local placementWorker

local function tryPlaceEntry(e)
	local place = e.place
	if not place then return true end
	local pos = place.Pos and Vector3.new(place.Pos.x, place.Pos.y, place.Pos.z) or nil
	if pos and findTowerByPos(pos, 1.0) then return true end
	local price = getSlotPriceForUnit(place.UnitId)
	local money = Macro.GetMoney()
	if price and money < price then return false end
	local cf = place.CFrame and deserializeArg(place.CFrame) or (pos and CFrame.new(pos)) or nil
	if not cf then return true end
	fireRemote("TowerAdd", { UnitId = place.UnitId, Name = place.Name, Pos = pos or cf.Position, CFrame = cf })
	task.wait(0.4)
	if pos then return findTowerByPos(pos, 1.5) ~= nil end
	return true
end

local function startPlacementQueue()
	placementQueue = {}
	for _, e in ipairs(Macro.Actions) do
		if e.type == "TowerAdd" and e.place then
			table.insert(placementQueue, { entry = e, placed = false, attempts = 0 })
		end
	end
	queueMode = #placementQueue > 0
	if not queueMode then return end
	print("[Macro] Queue mode: "..#placementQueue.." towers to place ASAP")
	if placementWorker then pcall(task.cancel, placementWorker) end
	placementWorker = track(function()
		while Macro.Playing and #placementQueue > 0 do
			local progressed = false
			for _, item in ipairs(placementQueue) do
				if not item.placed and Macro.Playing then
					item.attempts = item.attempts + 1
					local ok, perr = pcall(tryPlaceEntry, item.entry)
					if not ok and item.attempts <= 2 then warn("[Macro] place error: "..tostring(perr)) end
					if ok and (not item.entry.place.Pos or findTowerByPos(Vector3.new(item.entry.place.Pos.x, item.entry.place.Pos.y, item.entry.place.Pos.z), 1.5)) then
						item.placed = true
						progressed = true
						print("[Macro] Queued tower placed: "..tostring(item.entry.place.Name))
					end
				end
			end
			for i = #placementQueue, 1, -1 do
				if placementQueue[i].placed then table.remove(placementQueue, i) end
			end
			if not progressed then task.wait(0.3) else task.wait(0.1) end
		end
		queueMode = false
		placementQueue = {}
	end)
end

local function recordAction(rmName, args)
	if rmName == "WaveSkip" then
		if Macro.AutoSkip then return end
		local last = Macro.Actions[#Macro.Actions]
		local entryT = os.clock() - Macro.StartTime
		if last and last.type == "WaveSkip" and (entryT - (last.t or 0)) < 0.1 then return end
	end
	local entry = { t = os.clock() - Macro.StartTime, type = rmName, args = {} }
	if (rmName == "TowerUpgrade" or rmName == "TowerSell" or rmName == "TowerTarget") and args[1] and args[1].Id then
		for _, t in ipairs(getPlacedTowers()) do
			if t.Id == args[1].Id and t.Pos then
				entry.pos = { x = t.Pos.X, y = t.Pos.Y, z = t.Pos.Z }
				entry.towerName = t.Name
				entry.levelBefore = t.Level or 1
				break
			end
		end
	end
	for i, a in ipairs(args) do entry.args[i] = serializeArg(a) end
	if rmName == "TowerAdd" and args[1] then
		local a = args[1]
		entry.place = {
			UnitId = a.UnitId, Name = a.Name,
			Pos = a.Pos and { x = a.Pos.X, y = a.Pos.Y, z = a.Pos.Z } or nil,
			CFrame = a.CFrame and serializeArg(a.CFrame) or nil,
		}
	end
	table.insert(Macro.Actions, entry)
	print(string.format("[Macro] REC #%d %s t=%.2fs", #Macro.Actions, rmName, entry.t))
end

local function autosaveRecording()
	if not Macro.Recording or #Macro.Actions == 0 then return end
	local data = {
		version = 4,
		partial = true,
		actions = Macro.Actions,
		targetLevels = Macro.TargetLevels,
		meta = Macro.Meta,
		settings = Macro.Settings,
		at = os.date("%Y-%m-%d %H:%M:%S"),
	}
	pcall(function()
		writefile(recPath(), HttpService:JSONEncode(data))
	end)
end

local function recoverRec()
	local candidates = {}
	if Config.lastMacro then table.insert(candidates, Config.lastMacro) end
	if Macro.CurrentMacroName and Macro.CurrentMacroName ~= Config.lastMacro then
		table.insert(candidates, Macro.CurrentMacroName)
	end
	for _, n in ipairs(candidates) do
		local p = recPath(n)
		if isfile(p) then
			local ok, data = pcall(function()
				return HttpService:JSONDecode(readfile(p))
			end)
			if ok and type(data) == "table" and type(data.actions) == "table" and #data.actions > 0 then
				Macro.Actions = data.actions
				Macro.TargetLevels = data.targetLevels or {}
				if type(data.meta) == "table" then Macro.Meta = data.meta end
				if type(Macro.Meta.matches) ~= "table" then Macro.Meta.matches = {} end
				Macro.CurrentMacroName = n
				Config.lastMacro = n
				saveConfig()
				if not next(Macro.TargetLevels) then Macro.BuildTargetLevels() end
				return n, #data.actions
			end
		end
	end
	return nil, 0
end

function Macro.SetSpeed(mult)
