-- ========== Воспроизведение ==========

function Macro.Play()
	if Macro.Playing or #Macro.Actions == 0 then
		if #Macro.Actions == 0 then warn("[Macro] No actions") end
		return
	end
	Macro.Playing = true
	Macro.StopFlag = false

	if Macro.Settings.VoteMode and Macro.Settings.VoteMode ~= "None" then
		Macro.VoteMode(Macro.Settings.VoteMode)
	end

	if Macro.Settings.AutoSkipBeforeRecord then
		Macro.SetAutoSkip(true)
	end

	if Macro.Settings.Speed15 then
		Macro.SetSpeed(1.5)
	end

	if Macro.Settings.SmartUpgrade ~= false and next(Macro.TargetLevels) then
		Macro.SetAutoUpgrade(true)
	end

	queueMode = false
	placementQueue = {}
	if Macro.Settings.PlaceByTimer ~= true then
		startPlacementQueue()
	end

	print("[Macro] === PLAYBACK START: "..#Macro.Actions.." actions ===")

	local lastT = 0
	for i, entry in ipairs(Macro.Actions) do
		if Macro.StopFlag then break end
		local delay = (entry.t or 0) - lastT
		if delay > 0 then task.wait(delay) end
		lastT = entry.t or 0

		local skipAdd = queueMode and entry.type == "TowerAdd"

		if entry.type ~= "TowerUpgrade" and not skipAdd then
			local ok, err = pcall(function()
				if entry.type == "TowerAdd" and entry.place then
					if entry.place.Pos then
						local existing = findTowerByPos(Vector3.new(entry.place.Pos.x, entry.place.Pos.y, entry.place.Pos.z), 1.0)
						if existing then return end
					end
					local cf = entry.place.CFrame and deserializeArg(entry.place.CFrame) or nil
					local pos = entry.place.Pos and Vector3.new(entry.place.Pos.x, entry.place.Pos.y, entry.place.Pos.z) or nil
					if not cf and pos then cf = CFrame.new(pos) end
					if cf then
						fireRemote("TowerAdd", { UnitId = entry.place.UnitId, Name = entry.place.Name, Pos = pos or cf.Position, CFrame = cf })
					end
				elseif entry.type == "WaveSkip" then
					Macro.SkipWave()
				elseif entry.type == "TowerSell" then
					if entry.pos then
						Macro.SellTowerAt(Vector3.new(entry.pos.x, entry.pos.y, entry.pos.z))
					elseif entry.args and entry.args[1] and entry.args[1].Id then
						Macro.SellTower(entry.args[1].Id)
					end
				elseif entry.type == "TowerTarget" then
					if entry.args and entry.args[1] then
						fireRemote("TowerTarget", deserializeArg(entry.args[1]))
					end
				elseif entry.type == "TowerRemove" then
					if entry.args and entry.args[1] and entry.args[1].Id then
						fireRemote("TowerRemove", entry.args[1].Id)
					end
				else
					local args = {}
					for j, a in ipairs(entry.args or {}) do args[j] = deserializeArg(a) end
					fireRemote(entry.type, unpack(args))
				end
			end)
			if not ok then warn("[Macro] Error #"..i..": "..tostring(err)) end
		end
	end
	if queueMode and #placementQueue > 0 and not Macro.StopFlag then
		print("[Macro] Waiting for placement queue: "..#placementQueue.." left")
		local deadline = os.clock() + 60
		while #placementQueue > 0 and not Macro.StopFlag and os.clock() < deadline do
			task.wait(0.2)
		end
	end
	Macro.Playing = false
	print("[Macro] === PLAYBACK DONE ===")
end

