local function mergeConfig(decoded)
	local c = {
		version = 4,
		autoload = true,
		autoJoin = false,
		autoExecute = true,
		lastMacro = nil,
		lastMap = nil,
		posOffset = { x = 0, y = 0, z = 0 },
