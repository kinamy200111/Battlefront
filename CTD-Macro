function Macro.BuildTargetLevels()
	local targets = {}
	local order = {}
	for _, a in ipairs(Macro.Actions) do
		if a.type == "TowerUpgrade" and a.pos then
			local key = makePosKey(applyOffset(Vector3.new(a.pos.x, a.pos.y, a.pos.z)))
			local targetLevel = (a.levelBefore or 1) + 1
			if not targets[key] then
				targets[key] = targetLevel
				table.insert(order, key)
			elseif targets[key] < targetLevel then
				targets[key] = targetLevel
			end
		end
	end
	Macro.TargetLevels = targets
	Macro.TargetOrder = order
end

local autoUpgradeThread
function Macro.SetAutoUpgrade(enabled)
	Macro.AutoUpgrade = enabled
	if autoUpgradeThread then pcall(task.cancel, autoUpgradeThread); autoUpgradeThread = nil end
	if enabled then
		if #Macro.Actions > 0 or not next(Macro.TargetLevels) then Macro.BuildTargetLevels() end
		autoUpgradeThread = track(function()
			while Macro.AutoUpgrade and not matchEnded() do
				pcall(function()
					local function tryKey(key)
						local target = Macro.TargetLevels[key]
						if not target then return false end
						for _, t in ipairs(getPlacedTowers()) do
							if t.OwnerUserId == LocalPlayer.UserId and t.Pos and makePosKey(t.Pos) == key then
								local level = t.Level or 1
								if level < target then
									local price = getUpgradePrice(t.Name, level)
									if price and Macro.GetMoney() < price then
										return "wait"
									end
									fireRemote("TowerUpgrade", { Id = t.Id })
									task.wait(0.5)
									return true
								end
								return false
							end
						end
						return false
					end
					local order = Macro.TargetOrder
					if order and #order > 0 then
						for _, key in ipairs(order) do
							if not Macro.AutoUpgrade then return end
							local r = tryKey(key)
							if r == true then break end
						end
					else
						for _, t in ipairs(getPlacedTowers()) do
							if t.OwnerUserId == LocalPlayer.UserId and t.Pos then
								local level = t.Level or 1
								local target = Macro.TargetLevels[makePosKey(t.Pos)]
								if target and level < target then
									local price = getUpgradePrice(t.Name, level)
									if not price or Macro.GetMoney() >= price then
										fireRemote("TowerUpgrade", { Id = t.Id })
										task.wait(0.5)
									end
								end
							end
						end
					end
				end)
				task.wait(0.2)
			end
		end)
	end
end

