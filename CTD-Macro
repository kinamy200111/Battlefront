local lastTradeSig = nil
local function tradePollOnce()
	if Macro.Settings.TradeHelper == false then
		tradeOverlay(nil)
		return
	end
	local pg = LocalPlayer and LocalPlayer.PlayerGui
	local main = pg and pg:FindFirstChild("Main")
	main = main and main:FindFirstChild("Main")
	local trade = main and main:FindFirstChild("Trade")
	if not trade or not trade.Visible then
		lastTradeSig = nil
		tradeOverlay(nil)
		return
	end
	local tf = trade:FindFirstChild("TradeFrame")
	local menu = tf and tf:FindFirstChild("TradeMenu")
	if not menu then return end
	local mine = menu:FindFirstChild("YourItemsOffer")
	mine = mine and mine:FindFirstChild("Items")
	local theirs = menu:FindFirstChild("PlayerItemsOffer")
	theirs = theirs and theirs:FindFirstChild("Items")
	local myItems, myUnknown = tradeItems(mine)
	local thItems, thUnknown = tradeItems(theirs)
	local mySum, thSum = sumValues(myItems), sumValues(thItems)
	local myG = gemText(menu:FindFirstChild("YourGems"))
	local thG = gemText(menu:FindFirstChild("PlayerGems"))
	local function sigOf(list, s, g)
		local names = {}
		for _, it in ipairs(list) do names[#names + 1] = it.name end
		table.sort(names)
		return table.concat(names, ",").."|"..tostring(s).."|"..tostring(g)
	end
	local sig = sigOf(myItems, mySum, myG).."//"..sigOf(thItems, thSum, thG)
	if sig == lastTradeSig then return end
	lastTradeSig = sig
	local verdict
	if #myItems > 0 or #thItems > 0 or (myG or 0) > 0 or (thG or 0) > 0 then
		if mySum > thSum then
			verdict = "WIN +"..string.format("%.2f", mySum - thSum)
		elseif mySum < thSum then
			verdict = "LOSE -"..string.format("%.2f", thSum - mySum)
		else
			verdict = "РАВНО"
		end
	end
	tradeOverlay({
		verdict = verdict,
		mySum = mySum, thSum = thSum,
		myN = #myItems, thN = #thItems,
		myG = myG, thG = thG,
	})
	print(string.format("[Trade] Вы: %.2f (%d шт, гемы: %s) | Соперник: %.2f (%d шт, гемы: %s)%s",
		mySum, #myItems, tostring(myG or "?"), thSum, #thItems, tostring(thG or "?"),
		verdict and (" -> "..verdict) or ""))
	local unk = {}
	for _, n in ipairs(myUnknown) do unk[#unk + 1] = "вы:"..n end
	for _, n in ipairs(thUnknown) do unk[#unk + 1] = "он:"..n end
	if #unk > 0 then
		print("[Trade] нет в price-листе: "..table.concat(unk, ", "))
	end
end

local function printInventoryValue()
	local inv = scanInventory()
	if not inv or #inv == 0 then
		notify("Value инвентаря", "Инвентарь не виден — открой его (фильтр Towers)")
		return
	end
	local total, known, unknown, n = 0, {}, {}, 0
	for _, u in ipairs(inv) do
		n = n + 1
		local v = valueOfUnit(u.name)
		if v then
			total = total + v
			known[#known + 1] = { name = u.name, v = v }
		else
			unknown[#unknown + 1] = u.name
		end
	end
	table.sort(known, function(a, b) return a.v > b.v end)
	local parts = {}
	for i = 1, math.min(8, #known) do
		parts[#parts + 1] = string.format("%s=%.2f", known[i].name, known[i].v)
	end
	print(string.format("[Macro] Value инвентаря: %.2f (позиций: %d, с ценой: %d)", total, n, #known))
	if #parts > 0 then print("[Macro] Топ: "..table.concat(parts, ", ")) end
	if #unknown > 0 then print("[Macro] Без цены: "..table.concat(unknown, ", ")) end
	notify("Value инвентаря", string.format("%.2f (%d позиций)", total, n))
end

