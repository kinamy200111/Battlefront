-- ========== Запись ==========

local function serializeArg(a)
	local t = typeof(a)
	if t == "CFrame" then return { _type = "CFrame", components = { a:GetComponents() } }
	elseif t == "Vector3" then return { _type = "Vector3", x = a.X, y = a.Y, z = a.Z }
	elseif t == "table" then
		local out = {}
		for k, v in pairs(a) do out[k] = serializeArg(v) end
		return out
	elseif t == "string" or t == "number" or t == "boolean" then return a
	else return tostring(a) end
end

local function deserializeArg(a)
	if type(a) ~= "table" then return a end
	if a._type == "CFrame" then return CFrame.new(unpack(a.components))
	elseif a._type == "Vector3" then return Vector3.new(a.x, a.y, a.z)
	else
		local out = {}
		for k, v in pairs(a) do out[k] = deserializeArg(v) end
		return out
	end
end

-- ========== Replay-движок: точное повторение записи (порядок + деньги) ==========

local function waitMoneyAtLeast(need, label)
	if not need then return true end
	local printed = false
	local lastPrint = 0
	while not Macro.StopFlag do
		if matchEnded() then
			print("[Macro] матч закончился — отменяю ожидание денег ("..label..")")
			return false
		end
		local money = Macro.GetMoney()
		if money >= need then return true end
		if not printed or (os.clock() - lastPrint) > 30 then
			printed = true
			lastPrint = os.clock()
			print(string.format("[Macro] жду деньги %d/%d (%s)", money, need, label))
		end
		task.wait(0.25)
	end
	return false
end

local function findOwnTowerNear(pos, radius)
	local best, bestDist
	for _, t in ipairs(getPlacedTowers()) do
		if t.OwnerUserId == LocalPlayer.UserId and t.Pos and t.Id then
			local d = (Vector3.new(t.Pos.X, t.Pos.Y, t.Pos.Z) - pos).Magnitude
			if d <= radius and (not bestDist or d < bestDist) then
				best, bestDist = t, d
			end
		end
	end
	return best
end

local function replayPlace(entry)
	local place = entry.place
	if not place then return end
	local rawPos = place.Pos and Vector3.new(place.Pos.x, place.Pos.y, place.Pos.z) or nil
	local pos = rawPos and applyOffset(rawPos) or nil
	if pos and findOwnTowerNear(pos, 1.0) then return end -- уже стоит
	if pos and not posInArea(pos) then
		warn("[Macro] пропуск постройки "..tostring(place.Name)..": позиция вне карты (pos="..string.format("%.0f,%.0f,%.0f", pos.X, pos.Y, pos.Z)..") — перезапиши макрос (F6) или поправь posOffset")
		return
	end
	local price = getSlotPriceForUnit(place.UnitId)
	if not waitMoneyAtLeast(price, "Place "..tostring(place.Name)) then return end
	local cf = place.CFrame and deserializeArg(place.CFrame) or (pos and CFrame.new(pos)) or nil
	if not cf then return end
	if pos and rawPos and pos ~= rawPos then cf = cf + (pos - rawPos) end
	for attempt = 1, 5 do
		if Macro.StopFlag or matchEnded() then return end
		if pos and findOwnTowerNear(pos, 1.0) then return end
		fireRemote("TowerAdd", { UnitId = place.UnitId, Name = place.Name, Pos = pos or cf.Position, CFrame = cf })
		for _ = 1, 32 do -- до ~8с проверяю постановку (сервер принимает с задержкой)
			task.wait(0.25)
			if Macro.StopFlag or matchEnded() then return end
			if pos and findOwnTowerNear(pos, 1.5) then
				print("[Macro] поставил: "..tostring(place.Name))
				return
			end
		end
		warn("[Macro] TowerAdd не подтвердился: "..tostring(place.Name).." (попытка "..attempt..")")
		task.wait(0.5)
	end
	warn("[Macro] не удалось поставить: "..tostring(place.Name))
end

local function replayUpgrade(entry)
	if not entry.pos then return end
	local name = entry.towerName or "?"
	local target = (entry.levelBefore or 1) + 1
	local rawPos = Vector3.new(entry.pos.x, entry.pos.y, entry.pos.z)
	local pos = applyOffset(rawPos)
	for attempt = 1, 15 do
		if Macro.StopFlag or matchEnded() then return end
		local tower = findOwnTowerNear(pos, 1.5)
		if not tower then
			warn("[Macro] апгрейд: башня "..name.." не найдена ("..string.format("%.0f,%.0f,%.0f", pos.X, pos.Y, pos.Z)..") — пропускаю шаг до L"..target)
			return
		end
		local level = tower.Level or 1
		if level >= target then return end -- уже на нужном уровне (прошлые шаги/катка)
		local price = getUpgradePrice(tower.Name or name, level)
		if price == nil and getTowerConfig() then
			-- конфиг есть, а цены для этого уровня нет — выше максимума
			print(string.format("[Macro] %s: шаг L%d→L%d отсутствует в конфиге — пропускаю (макс. уровень?)", name, level, target))
			return
		end
		if not waitMoneyAtLeast(price, string.format("Upgrade %s L%d→L%d", name, level, target)) then return end
		fireRemote("TowerUpgrade", { Id = tower.Id })
		local up = false
		for _ = 1, 40 do -- до ~10с проверяю, что уровень рос (сервер применяет с задержкой)
			task.wait(0.25)
			if Macro.StopFlag or matchEnded() then return end
			local t2 = findOwnTowerNear(pos, 1.5)
			if t2 and (t2.Level or 1) > level then up = true break end
		end
		if up then
			local cur = findOwnTowerNear(pos, 1.5)
			local lv = cur and (cur.Level or (level + 1)) or (level + 1)
			if lv >= target then
				print(string.format("[Macro] %s → L%d", name, target))
			end
			-- цель не достигнута — следующий проход цикла докачает
		else
			warn(string.format("[Macro] %s: сервер не применил L%d→L%d (попытка %d)", name, level, target, attempt))
			task.wait(1.2)
		end
	end
	warn("[Macro] апгрейд не прошёл: "..name.." → L"..target)
end

local function recordAction(rmName, args)
	if rmName == "WaveSkip" then
		if Macro.AutoSkip then return end
		local last = Macro.Actions[#Macro.Actions]
		local entryT = os.clock() - Macro.StartTime
		if last and last.type == "WaveSkip" and (entryT - (last.t or 0)) < 0.1 then return end
	end
	local entry = { t = os.clock() - Macro.StartTime, type = rmName, args = {} }
	if (rmName == "TowerUpgrade" or rmName == "TowerSell" or rmName == "TowerTarget") and args[1] and args[1].Id then
		for _, t in ipairs(getPlacedTowers()) do
			if t.Id == args[1].Id and t.Pos then
				entry.pos = { x = t.Pos.X, y = t.Pos.Y, z = t.Pos.Z }
				entry.towerName = t.Name
				entry.levelBefore = t.Level or 1
				break
			end
		end
	end
	for i, a in ipairs(args) do entry.args[i] = serializeArg(a) end
	if rmName == "TowerAdd" and args[1] then
		local a = args[1]
		entry.place = {
			UnitId = a.UnitId, Name = a.Name,
			Pos = a.Pos and { x = a.Pos.X, y = a.Pos.Y, z = a.Pos.Z } or nil,
			CFrame = a.CFrame and serializeArg(a.CFrame) or nil,
		}
	end
	table.insert(Macro.Actions, entry)
	print(string.format("[Macro] REC #%d %s t=%.2fs", #Macro.Actions, rmName, entry.t))
end

local function autosaveRecording()
	if not Macro.Recording or #Macro.Actions == 0 then return end
	local data = {
		version = 4,
		partial = true,
		actions = Macro.Actions,
		targetLevels = Macro.TargetLevels,
		meta = Macro.Meta,
		settings = Macro.Settings,
		at = os.date("%Y-%m-%d %H:%M:%S"),
	}
	pcall(function()
		writefile(recPath(), HttpService:JSONEncode(data))
	end)
end

local function recoverRec()
	local candidates = {}
	if Config.lastMacro then table.insert(candidates, Config.lastMacro) end
	if Macro.CurrentMacroName and Macro.CurrentMacroName ~= Config.lastMacro then
		table.insert(candidates, Macro.CurrentMacroName)
	end
	for _, n in ipairs(candidates) do
		local p = recPath(n)
		if isfile(p) then
			local ok, data = pcall(function()
				return HttpService:JSONDecode(readfile(p))
			end)
			if ok and type(data) == "table" and type(data.actions) == "table" and #data.actions > 0 then
				Macro.Actions = data.actions
				Macro.TargetLevels = {}
				if type(data.meta) == "table" then Macro.Meta = data.meta end
				if type(Macro.Meta.matches) ~= "table" then Macro.Meta.matches = {} end
				Macro.CurrentMacroName = n
				Config.lastMacro = n
				saveConfig()
				Macro.BuildTargetLevels()
				return n, #data.actions
			end
		end
	end
	return nil, 0
end

function Macro.SetSpeed(mult)
	local res = invokeRemote("ChangeSpeed", mult)
	print("[Macro] ChangeSpeed -> "..tostring(mult).." (res="..tostring(res)..")")
	return res ~= nil
end

function Macro.StartRecording()
	if Macro.Recording then return end
	Macro.Actions = {}
	Macro.TargetLevels = {}
	Macro.Meta = { matches = {} }
	if Config.lastMap and not Macro.Meta.map then Macro.Meta.map = Config.lastMap end
	Macro.StartTime = os.clock()
	Macro.Recording = true
	G.CameraTDRecording = true
	G.CameraTDOnRemote = recordAction
	if Macro.Settings.VoteMode and Macro.Settings.VoteMode ~= "None" then
		Macro.VoteMode(Macro.Settings.VoteMode)
	end
	if Macro.Settings.AutoSkipBeforeRecord then
		Macro.SetAutoSkip(true)
	end
	print("[Macro] === RECORDING STARTED ===")
end

function Macro.StopRecording()
	Macro.Recording = false
	G.CameraTDRecording = false
	Macro.BuildTargetLevels()
	autosaveRecording()
	print(string.format("[Macro] === RECORDING STOPPED: %d actions (autosaved rec) ===", #Macro.Actions))
end

-- ========== Воспроизведение ==========

function Macro.Play()
	if Macro.Playing or #Macro.Actions == 0 then
		if #Macro.Actions == 0 then warn("[Macro] No actions") end
		return
	end
	Macro.Playing = true
	Macro.StopFlag = false

	if Macro.Settings.VoteMode and Macro.Settings.VoteMode ~= "None" then
		Macro.VoteMode(Macro.Settings.VoteMode)
	end

	if Macro.Settings.AutoSkipBeforeRecord then
		Macro.SetAutoSkip(true)
	end

	if Macro.Settings.Speed15 then
		Macro.SetSpeed(1.5)
	end

	local timed = Macro.Settings.PlaceByTimer == true

	if timed and Macro.Settings.SmartUpgrade ~= false and next(Macro.TargetLevels) then
		Macro.SetAutoUpgrade(true)
	end

	if not timed then
		-- replay идёт строго по порядку записи — фоновый автоапгрейд мешал бы
		if Macro.AutoUpgrade then
			Macro.SetAutoUpgrade(false)
			print("[Macro] Smart Upgrade выкл на время replay (включится после отработки записи)")
		end
	end

	if timed then
		print("[Macro] === PLAYBACK START: "..#Macro.Actions.." actions (по таймеру записи) ===")
	else
		print("[Macro] === PLAYBACK START: "..#Macro.Actions.." actions (replay: порядок записи + ожидание денег) ===")
	end

	local lastT = 0
	for i, entry in ipairs(Macro.Actions) do
		if Macro.StopFlag then break end
		if timed then
			local delay = (entry.t or 0) - lastT
			if delay > 0 then task.wait(delay) end
			lastT = entry.t or 0
		end

		local ok, err = pcall(function()
			if entry.type == "TowerAdd" then
				if timed then
					if entry.place then
						if entry.place.Pos then
							local existing = findTowerByPos(Vector3.new(entry.place.Pos.x, entry.place.Pos.y, entry.place.Pos.z), 1.0)
							if existing then return end
						end
						local cf = entry.place.CFrame and deserializeArg(entry.place.CFrame) or nil
						local pos = entry.place.Pos and Vector3.new(entry.place.Pos.x, entry.place.Pos.y, entry.place.Pos.z) or nil
						if not cf and pos then cf = CFrame.new(pos) end
						if cf then
							fireRemote("TowerAdd", { UnitId = entry.place.UnitId, Name = entry.place.Name, Pos = pos or cf.Position, CFrame = cf })
						end
					end
				else
					replayPlace(entry)
				end
			elseif entry.type == "TowerUpgrade" then
				-- replay-режим: повторяем ТОТ шаг прокачки, что был при записи,
				-- в том же порядке — перемежаясь с постройками, как ты играл руками
				if not timed then
					replayUpgrade(entry)
				end
			elseif entry.type == "WaveSkip" then
				Macro.SkipWave()
			elseif entry.type == "TowerSell" then
				if entry.pos then
					Macro.SellTowerAt(Vector3.new(entry.pos.x, entry.pos.y, entry.pos.z))
				elseif entry.args and entry.args[1] and entry.args[1].Id then
					Macro.SellTower(entry.args[1].Id)
				end
			elseif entry.type == "TowerTarget" then
				if entry.args and entry.args[1] then
					fireRemote("TowerTarget", deserializeArg(entry.args[1]))
				end
			elseif entry.type == "TowerRemove" then
				if entry.args and entry.args[1] and entry.args[1].Id then
					fireRemote("TowerRemove", entry.args[1].Id)
				end
			else
				local args = {}
				for j, a in ipairs(entry.args or {}) do args[j] = deserializeArg(a) end
				fireRemote(entry.type, unpack(args))
			end
		end)
		if not ok then warn("[Macro] Error #"..i..": "..tostring(err)) end
		if matchEnded() then
			warn("[Macro] финальный экран — останавливаю replay")
			break
		end
		if not timed then task.wait(0.1) end
	end

	Macro.Playing = false
	print("[Macro] === PLAYBACK DONE ===")

	-- после отработки записи — Smart Upgrade добирает цели (страховка)
	if not timed and not Macro.StopFlag and not matchEnded() and Macro.Settings.SmartUpgrade ~= false and next(Macro.TargetLevels) then
		Macro.SetAutoUpgrade(true)
	end
end

