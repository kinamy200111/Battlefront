function Macro.StopRecording()
	Macro.Recording = false
	G.CameraTDRecording = false
	Macro.BuildTargetLevels()
	autosaveRecording()
	print(string.format("[Macro] === RECORDING STOPPED: %d actions (autosaved rec) ===", #Macro.Actions))
