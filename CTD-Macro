-- ========== Anti-AFK ==========

local function initAntiAfk()
	if G.CameraTDAntiAfk then return end
	G.CameraTDAntiAfk = true
	if LocalPlayer then
		pcall(function()
			LocalPlayer.Idled:Connect(function()
				if Macro.Settings.AntiAfk == false then return end
				pcall(function()
					local VirtualUser = game:GetService("VirtualUser")
					VirtualUser:CaptureController()
					VirtualUser:ClickButton2(Vector2.new(0, 0))
				end)
				print("[Macro] Anti-AFK: простой сброшен (Idled)")
			end)
		end)
	end
	track(function()
		while true do
			task.wait(120)
			if Macro.Settings.AntiAfk ~= false then
				pcall(function()
					local loc = UserInputService:GetMouseLocation()
					VirtualInputManager:SendMouseMoveEvent(loc.X + 2, loc.Y + 2)
					VirtualInputManager:SendMouseMoveEvent(loc.X, loc.Y)
				end)
			end
		end
	end)
	print("[Macro] Anti-AFK активен (проверка каждые 120с)")
end

-- ========== Hotkeys ==========

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.F1 then
		if Window and Window.Toggle then
			Window:Toggle()
			if Toggles and Toggles.MenuToggle then
				Toggles.MenuToggle:SetValue(Library.Toggled)
			end
		end
	elseif input.KeyCode == Enum.KeyCode.F6 then
		if Macro.Recording then Macro.StopRecording() else Macro.StartRecording() end
	elseif input.KeyCode == Enum.KeyCode.F7 then
		if ensureLoaded() then
			track(function() Macro.Play() end)
		else
			notify("Error", "Нет действий — загрузи макрос (F10)")
		end
	elseif input.KeyCode == Enum.KeyCode.F8 then
		Macro.Stop()
	elseif input.KeyCode == Enum.KeyCode.F9 then
		Macro.Save(Macro.CurrentMacroName)
		if macroDropdownRef then macroDropdownRef:SetValues(refreshMacroList()) end
	elseif input.KeyCode == Enum.KeyCode.F10 then
		Macro.Load(Macro.CurrentMacroName)
	end
end)

