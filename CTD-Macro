local function getSlotPriceForUnit(unitId)
	local replica = getReplica()
	local eq
	if replica and replica.Data and replica.Data.Towers then
		local info = replica.Data.Towers[unitId]
		if info then eq = info.Equipped end
	end
	if not eq then return nil end
	local pg = LocalPlayer and LocalPlayer.PlayerGui
	local gui = pg and pg:FindFirstChild("GameUI")
	local slots = gui and gui:FindFirstChild("Slots")
	local slot = slots and slots:FindFirstChild("Slot"..tostring(eq))
	local troop = slot and slot:FindFirstChild("TroopFrame")
	local price = troop and troop:FindFirstChild("Price")
	if price and (price:IsA("TextLabel") or price:IsA("TextButton")) then
		return parseDigits(price.Text)
	end
	return nil
end

