end

function Macro.GetMoney()
	local pg = LocalPlayer and LocalPlayer.PlayerGui
	local gui = pg and pg:FindFirstChild("GameUI")
	local stats = gui and gui:FindFirstChild("Stats")
	local other = stats and stats:FindFirstChild("OtherUI")
	local moneyFrame = other and other:FindFirstChild("Money")
