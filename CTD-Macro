		settings = { VoteMode = "Normal", AutoSkipBeforeRecord = false, PlaceByTimer = false, SmartUpgrade = true, AntiAfk = true, AfterMatch = "PlayAgain", Speed15 = false, MenuVisible = true, AutoReconnect = true, ElevatorHpMod = true, ElevatorSpeedMod = true, TradeHelper = true },
	}
	if type(decoded) == "table" then
		for k, v in pairs(decoded) do
			if k == "settings" and type(v) == "table" then
				for sk, sv in pairs(v) do c.settings[sk] = sv end
			elseif k == "farm" and type(v) == "table" then
				for sk, sv in pairs(v) do c.farm[sk] = sv end
			elseif k == "posOffset" and type(v) == "table" then
				for sk, sv in pairs(v) do c.posOffset[sk] = sv end
			else
				c[k] = v
			end
		end
	end
	return c
end
local ConfigRead = false
