local function tradeItems(container)
	local items, unknown = {}, {}
	if not container then return items, unknown end
	for _, fr in ipairs(container:GetChildren()) do
		local nm
		if fr.GetAttribute then nm = fr:GetAttribute("OriginalName") end
		if type(nm) == "string" and nm ~= "" then
			local v = valueOfUnit(nm)
			items[#items + 1] = { name = nm, value = v }
			if not v then unknown[#unknown + 1] = nm end
		end
	end
	return items, unknown
end

local function sumValues(items)
	local s = 0
	for _, it in ipairs(items) do s = s + (it.value or 0) end
	return s
end

local function gemText(frame)
	if not frame then return nil end
	for _, d in ipairs(frame:GetDescendants()) do
		if (d:IsA("TextLabel") or d:IsA("TextBox")) and d.Name == "GemAmount" then
			local n = parseDigits(d.Text)
			if n then return n end
		end
	end
	return nil
end

local tradeGui, tradeTitle, tradeSub
local function tradeOverlay(state)
	if state == nil and tradeGui == nil then return end
	if tradeGui == nil then
		local hui = nil
		pcall(function()
			local f = getgenv().get_hui
			if typeof(f) == "function" then hui = f() end
		end)
		if not hui then hui = game:GetService("CoreGui") end
		local old = hui:FindFirstChild("TradeHelperGui")
		if old then old:Destroy() end
		tradeGui = Instance.new("ScreenGui")
		tradeGui.Name = "TradeHelperGui"
		tradeGui.ResetOnSpawn = false
		tradeGui.DisplayOrder = 999
		tradeGui.IgnoreGuiInset = true
		tradeGui.Parent = hui
		local box = Instance.new("Frame")
		box.Name = "Box"
		box.AnchorPoint = Vector2.new(0.5, 0)
		box.Position = UDim2.new(0.5, 0, 0, 72)
		box.Size = UDim2.fromOffset(320, 80)
		box.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
		box.BackgroundTransparency = 0.12
		box.BorderSizePixel = 0
		box.Parent = tradeGui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = box
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(60, 62, 72)
		stroke.Thickness = 1
		stroke.Transparency = 0.35
		stroke.Parent = box
		tradeTitle = Instance.new("TextLabel")
		tradeTitle.BackgroundTransparency = 1
		tradeTitle.Position = UDim2.new(0, 0, 0, 8)
		tradeTitle.Size = UDim2.new(1, 0, 0, 38)
		tradeTitle.Font = Enum.Font.GothamBold
		tradeTitle.TextSize = 24
		tradeTitle.Text = ""
		tradeTitle.TextStrokeTransparency = 0.85
		tradeTitle.Parent = box
		tradeSub = Instance.new("TextLabel")
		tradeSub.BackgroundTransparency = 1
		tradeSub.Position = UDim2.new(0, 0, 0, 48)
		tradeSub.Size = UDim2.new(1, 0, 0, 24)
		tradeSub.Font = Enum.Font.Gotham
		tradeSub.TextSize = 14
		tradeSub.TextColor3 = Color3.fromRGB(200, 200, 210)
		tradeSub.Text = ""
		tradeSub.Parent = box
	end
	if state == nil then
		tradeGui.Enabled = false
		return
	end
	tradeGui.Enabled = true
	if state.verdict then
		tradeTitle.Text = state.verdict
		local v = state.verdict
		if v:sub(1, 3) == "WIN" then
			tradeTitle.TextColor3 = Color3.fromRGB(110, 255, 140)
		elseif v:sub(1, 4) == "LOSE" then
			tradeTitle.TextColor3 = Color3.fromRGB(255, 105, 105)
		else
			tradeTitle.TextColor3 = Color3.fromRGB(235, 235, 160)
		end
	else
		tradeTitle.Text = "ЖДЁМ ПРЕДЛОЖЕНИЯ"
		tradeTitle.TextColor3 = Color3.fromRGB(180, 182, 195)
	end
	local g = ""
	local mg, tg = tonumber(state.myG), tonumber(state.thG)
	if (mg or 0) > 0 or (tg or 0) > 0 then
		g = string.format("  |  гемы %d/%d", mg or 0, tg or 0)
	end
	tradeSub.Text = string.format("Ты %.2f (%d шт)  •  Соперник %.2f (%d шт)%s",
		state.mySum or 0, state.myN or 0, state.thSum or 0, state.thN or 0, g)
end
