-- ========== Multi-Macro Save/Load ==========

local function collectUnits(actions)
	local seen, list = {}, {}
	for _, a in ipairs(actions or {}) do
		if a.type == "TowerAdd" and a.place and a.place.UnitId and not seen[a.place.UnitId] then
			seen[a.place.UnitId] = true
			list[#list + 1] = tostring(a.place.Name or a.place.UnitId)
		end
	end
	return list
end

function Macro.ListMacros()
	local files = {}
	local ok, result = pcall(function()
		return listfiles(MACRO_DIR)
	end)
	if ok and result then
		for _, f in ipairs(result) do
			if f:match("%.json$") then
				local name = f:match("([^/\\]+)%.json$")
				if name and name ~= "config" and not name:match("%.rec$") then
					table.insert(files, name)
				end
			end
		end
	end
	return files
end

local function recPath(name)
	return MACRO_DIR..(name or Macro.CurrentMacroName or "default")..".rec.json"
end

local function deleteRec(name)
	pcall(function()
		local p = recPath(name)
		if isfile(p) then delfile(p) end
	end)
end

function Macro.Save(name)
	name = name or Macro.CurrentMacroName or "default"
	Macro.CurrentMacroName = name
	Macro.Meta.units = collectUnits(Macro.Actions)
	local data = {
		version = 4,
		actions = Macro.Actions,
		targetLevels = Macro.TargetLevels,
		settings = Macro.Settings,
		meta = Macro.Meta,
		savedAt = os.date("%Y-%m-%d %H:%M:%S"),
	}
	local path = MACRO_DIR..name..".json"
	local ok, err = pcall(function()
		writefile(path, HttpService:JSONEncode(data))
	end)
	if ok then
		deleteRec(name)
		print("[Macro] Saved: "..path.." ("..#Macro.Actions.." actions)")
		if updateMacroInfo then pcall(updateMacroInfo, name) end
		return path
	end
	warn("[Macro] Save failed: "..tostring(err))
	return nil
end

function Macro.Load(name)
	name = name or Macro.CurrentMacroName or "default"
	Macro.CurrentMacroName = name
	local path = MACRO_DIR..name..".json"
	if not isfile(path) then
		warn("[Macro] Not found: "..path)
		return false
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(path))
	end)
	if not ok or type(data) ~= "table" then
		warn("[Macro] Bad json: "..path)
		return false
	end
	Macro.Actions = data.actions or {}
	Macro.TargetLevels = data.targetLevels or {}
	Macro.Meta = type(data.meta) == "table" and data.meta or { matches = {} }
	if type(Macro.Meta.matches) ~= "table" then Macro.Meta.matches = {} end
	if type(data.settings) == "table" then
		for k, v in pairs(data.settings) do Macro.Settings[k] = v end
		saveConfig()
	end
	if not next(Macro.TargetLevels) then Macro.BuildTargetLevels() end
	Config.lastMacro = name
	saveConfig()
	print(string.format("[Macro] Loaded %s: %d actions", name, #Macro.Actions))
	if applyConfigToUI then pcall(applyConfigToUI) end
	if updateMacroInfo then pcall(updateMacroInfo, name) end
	if autoJoinWanted() and inLobby() then
		local ok = pcall(startAutoJoin)
		if not ok then print("[Macro] autoJoin после Load не стартовал") end
	end
	return true
end

function Macro.DeleteMacro(name)
	if not name or name == "" or name == "config" then
		warn("[Macro] Удаление запрещено: "..tostring(name))
		return false
	end
	local path = MACRO_DIR..name..".json"
	if isfile(path) then
		delfile(path)
		deleteRec(name)
		print("[Macro] Deleted: "..name)
		return true
	end
	return false
end

