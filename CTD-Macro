					end
				end
			end
		end
	end)

	local ok, result = pcall(function()
		local path = MACRO_DIR.."Obsidian.lua"
		if not isfile(path) then
			local url = "https://raw.githubusercontent.com/deividcomsono/Obsidian/refs/heads/main/Library.lua"
			local src
			if typeof(HttpGet) == "function" then
				src = HttpGet(url)
			elseif typeof(game.HttpGet) == "function" then
				src = game:HttpGet(url)
			elseif typeof(request) == "function" then
				src = request({ Url = url, Method = "GET" }).Body
			else
				error("no http available")
			end
			if not src or #src < 1000 then error("download failed") end
			writefile(path, src)
		end
		return loadfile(path)()
	end)
