local function parseDurationText(text)
	if type(text) ~= "string" then return nil end
	local h, m, s = text:match("(%d+):(%d+):(%d+)")
	if h then return tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(s) end
	local mm, ss = text:match("(%d+):(%d+)")
	if mm then return tonumber(mm) * 60 + tonumber(ss) end
	return nil
end

local function parseCoins(final)
	local content = final:FindFirstChild("Content")
	local stats = content and content:FindFirstChild("Stats")
	if not stats then return nil, "" end
	local rawParts, sum, largest = {}, 0, nil
	for _, d in ipairs(stats:GetDescendants()) do
		if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible then
			local t = d.Text or ""
			if t:find("%d") then
				rawParts[#rawParts + 1] = d.Name.."="..t
				local plus = tonumber(t:match("^%+(%d+)"))
				local plain = tonumber(t:match("(%d+)"))
				if plus then
					sum = sum + plus
				elseif plain and (not largest or plain > largest) then
					largest = plain
				end
			end
		end
	end
	local dump = table.concat(rawParts, " | ")
	print("[Macro] FinalUI Stats dump: "..dump)
	local coins = (sum > 0) and sum or largest
	return coins, dump
end

local function parseFinalUI()
	local final = getFinalUI()
	if not final or not final.Visible then return nil end
	local content = final:FindFirstChild("Content")
	if not content then return nil end
	local function txt(n)
		local l = content:FindFirstChild(n)
		return l and l.Text or ""
	end
	local timeText = txt("TimeLabel")
	local mapText = txt("Map")
	local modeText = txt("Mode")
	local resultText = txt("Content")
	local dur = parseDurationText(timeText)
	if not dur and MatchState.t0 then
		dur = math.max(1, math.floor(os.clock() - MatchState.t0))
	end
	local coins, dump = parseCoins(final)
	return {
		dur = dur, coins = coins, time = timeText,
		map = mapText, mode = modeText, result = resultText, dump = dump,
	}
end

local function recordMatchResult()
	local r = parseFinalUI()
	if not r then return false end
	local meta = Macro.Meta
	meta.matches = meta.matches or {}
	if r.map and r.map ~= "" and r.map ~= "0" and not meta.mapManual then
		meta.map = r.map:gsub("^Map:%s*", "")
	end
	if r.mode and r.mode ~= "" and not meta.modeManual then meta.mode = r.mode end
	table.insert(meta.matches, 1, {
		at = os.date("%Y-%m-%d %H:%M"),
		dur = r.dur,
		coins = r.coins,
		time = r.time,
		result = r.result,
	})
	while #meta.matches > 5 do table.remove(meta.matches) end
	local totC, totS = 0, 0
	for _, m in ipairs(meta.matches) do
		if m.coins and m.dur and m.dur > 0 then
			totC = totC + m.coins
			totS = totS + m.dur
		end
	end
	meta.coinsPerHour = totS > 0 and math.floor(totC * 3600 / totS + 0.5) or nil
	print(string.format("[Macro] Катка: результат=%s время=%s монет=%s карта=%s монет/ч=%s",
		r.result ~= "" and r.result or "?",
		r.time ~= "" and r.time or tostring(r.dur).."s",
		tostring(r.coins or "?"),
		tostring(meta.map or "?"),
		tostring(meta.coinsPerHour or "?")))
	Macro.Save(Macro.CurrentMacroName)
	if updateMacroInfo then pcall(updateMacroInfo, Macro.CurrentMacroName) end
	return true
end

local function leaveMatch()
	local final = getFinalUI()
	local content = final and final:FindFirstChild("Content")
	local btn = content and content:FindFirstChild("Lobby")
	if btn and btn.Visible then
		vimClick(btn)
		print("[Macro] FinalUI Lobby clicked")
	end
	task.wait(7)
	if not inLobby() then
		print("[Macro] Still in match, firing OnLeave")
		fireRemote("OnLeave")
	end
end

local function playAgainMatch()
	local final = getFinalUI()
	local content = final and final:FindFirstChild("Content")
	local btn = content and content:FindFirstChild("PlayAgain")
	if btn and btn.Visible then
		vimClick(btn)
		print("[Macro] FinalUI PlayAgain clicked")
		task.wait(8)
	end
	if not inLobby() then
		local f2 = getFinalUI()
		local c2 = f2 and f2:FindFirstChild("Content")
		local b2 = c2 and c2:FindFirstChild("Lobby")
		if b2 and b2.Visible then
			print("[Macro] PlayAgain не перевёл — fallback: Lobby")
			leaveMatch()
		end
	end
end

local function onMatchFinished()
	local farmDone = false
	if Config.farm and Config.farm.active then
		Config.farm.done = (Config.farm.done or 0) + 1
		local done, target = Config.farm.done, Config.farm.target or 5
		if done >= target then
			Config.farm.active = false
			farmDone = true
			local cph = Macro.Meta.coinsPerHour
			notify("Фарм завершён", string.format("%d/%d каток%s", done, target,
				cph and (" | "..cph.." монет/ч") or ""))
		else
			notify("Фарм", string.format("Катка %d/%d", done, target))
		end
		saveConfig()
		if updateFarmLabel then pcall(updateFarmLabel) end
	end
	task.wait(4)
	local mode = Macro.Settings.AfterMatch or "PlayAgain"
	if farmDone or mode == "Lobby" then
		leaveMatch()
	elseif mode == "PlayAgain" then
		playAgainMatch()
	end
end

local function matchWatcher()
	MatchState = { t0 = nil, ended = false }
	local pg = LocalPlayer and LocalPlayer.PlayerGui
	local gui = pg and pg:WaitForChild("GameUI", 40)
	if not gui then
		print("[Macro] GameUI не найдена — не катка")
		return
	end
	MatchState.t0 = os.clock()
	print("[Macro] Матч-вотчер активен")
	while not MatchState.ended do
		if inLobby() then return end
		local final = gui:FindFirstChild("FinalUI")
		if final and final.Visible then
			MatchState.ended = true
			local ok, err = pcall(recordMatchResult)
			if not ok then warn("[Macro] parse error: "..tostring(err)) end
			pcall(onMatchFinished)
			return
		end
		task.wait(0.5)
	end
end

