local function getReplica()
	local Replication = getReplicationModule()
	return Replication and Replication.GetCurrentReplica and Replication.GetCurrentReplica()
end

local function getEquippedUnits()
	local replica = getReplica()
	local bySlot = {}
	if replica and replica.Data and replica.Data.Towers then
		for uid, info in pairs(replica.Data.Towers) do
			if info.Equipped then
				bySlot[info.Equipped] = { UnitId = uid, Name = info.Name, Slot = info.Equipped }
			end
		end
	end
	return bySlot
end

local function getPlacedTowers()
	local out = {}
	local GR = getGameReplicator()
	if GR and GR.Data and GR.Data.Towers then
		for id, data in pairs(GR.Data.Towers) do
			table.insert(out, {
				Id = id,
				Name = data.Name,
				UnitId = data.UnitId,
				Pos = data.Pos,
				Level = data.Level,
				OwnerUserId = data.OwnerUserId,
			})
		end
	end
	return out
end

local function findTowerByPos(pos, tolerance)
	tolerance = tolerance or 1.5
	local best, bestDist
	for _, t in ipairs(getPlacedTowers()) do
		if t.Pos then
			local d = (Vector3.new(t.Pos.X, t.Pos.Y, t.Pos.Z) - Vector3.new(pos.X, pos.Y, pos.Z)).Magnitude
			if d <= tolerance and (not bestDist or d < bestDist) then
				best, bestDist = t, d
			end
		end
	end
	return best
end

local function makePosKey(pos)
	return string.format("%.1f,%.1f,%.1f", pos.X, pos.Y, pos.Z)
end

local function fireRemote(name, ...)
	local remote = NetworkFolder:FindFirstChild(name)
	if not remote then return end
	remote:FireServer(...)
end

local function invokeRemote(name, ...)
	local rf = NetworkRF:FindFirstChild(name)
	if not rf then return nil end
	local args = { ... }
	local ok, res = pcall(function() return rf:InvokeServer(unpack(args)) end)
	return ok and res or nil
end

