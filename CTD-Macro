	local frame = inv and inv:FindFirstChild("InventoryFrame")
	local list = frame and frame:FindFirstChild("List")
	local scroll = list and list:FindFirstChild("ScrollingFrame")
	if not scroll then return nil end
	local out = {}
	for _, fr in ipairs(scroll:GetChildren()) do
		local nm
		if fr.GetAttribute then nm = fr:GetAttribute("SearchName") end
		if type(nm) == "string" and nm ~= "" then
			local tf = fr:FindFirstChild("TroopsFrame")
			local eq = tf and tf:FindFirstChild("Equipped")
			out[#out + 1] = { uuid = fr.Name, name = nm, equipped = eq ~= nil and eq.Visible == true }
		end
	end
	return out
end

local loadoutBusy = false

local function invTypes(inv)
	local t = {}
	for _, u in ipairs(inv) do
		local k = u.name:lower()
		local e = t[k]
		if not e then
			e = { name = u.name, uuid = u.uuid, equipped = u.equipped }
			t[k] = e
		elseif u.equipped and not e.equipped then
			e.equipped = true
			e.uuid = u.uuid
		end
	end
	return t
end

local function applyLoadoutImpl()
	if not inLobby() then return end
	if Macro.Recording or Macro.Playing then return end
	local meta = Macro.Meta or {}
	local src
	if type(meta.loadout) == "table" and next(meta.loadout) then
		src = meta.loadout
	elseif type(meta.units) == "table" and next(meta.units) then
		src = meta.units
	else
		src = collectUnits(Macro.Actions)
	end
	local target, seen = {}, {}
	for _, n in ipairs(src) do
		local k = tostring(n):lower()
		if not seen[k] then
			seen[k] = true
			target[#target + 1] = tostring(n)
		end
	end
	if #target == 0 then return end
	local inv = scanInventory()
	if not inv or #inv == 0 then
		print("[Macro] Лоудаут: инвентарь не виден (проверь фильтр Towers) — пропуск")
		return
	end
	local types = invTypes(inv)
	local want = {}
	for _, n in ipairs(target) do want[n:lower()] = true end
	local toEquip, toUnequip, absent = {}, {}, {}
	for _, n in ipairs(target) do
		local e = types[n:lower()]
		if not e then
			absent[#absent + 1] = n
		elseif not e.equipped then
			toEquip[#toEquip + 1] = e
		end
	end
	for k, e in pairs(types) do
		if e.equipped and not want[k] then
			toUnequip[#toUnequip + 1] = e
		end
	end
	if #absent > 0 then
		warn("[Macro] Лоудаут: нет в инвентаре: "..table.concat(absent, ", "))
	end
	if #toEquip == 0 and #toUnequip == 0 then
		print("[Macro] Лоудаут уже совпадает ("..#target.." юнитов): "..table.concat(target, ", "))
		return
	end
	print(string.format("[Macro] Лоудаут: экипировать %d, снять %d", #toEquip, #toUnequip))
	for _, e in ipairs(toUnequip) do
		fireRemote("EquipPart", e.uuid)
		task.wait(0.35)
	end
	for attempt = 1, 2 do
		local invNow = scanInventory()
		if not invNow then break end
		local typesNow = invTypes(invNow)
		for _, e in ipairs(toEquip) do
			local nt = typesNow[e.name:lower()]
			if nt and not nt.equipped then
				fireRemote("EquipPart", nt.uuid)
				task.wait(0.35)
			end
		end
		task.wait(0.6)
		local inv2 = scanInventory()
		if not inv2 then break end
		local t2 = invTypes(inv2)
		local missing, extra = 0, 0
		for k, e in pairs(t2) do
			if want[k] and not e.equipped then
				missing = missing + 1
			elseif not want[k] and e.equipped then
				extra = extra + 1
			end
		end
		if missing == 0 and extra == 0 then break end
		if attempt == 2 then
			warn(string.format("[Macro] Лоудаут: не экипированы %d, лишних %d", missing, extra))
		end
	end
	print("[Macro] Лоудаут применён: "..table.concat(target, ", "))
end

function applyLoadout()
	if loadoutBusy then return end
	loadoutBusy = true
	local ok, err = pcall(applyLoadoutImpl)
	loadoutBusy = false
	if not ok then warn("[Macro] Лоудаут: "..tostring(err)) end
end

function Macro.ListMacros()
	local files = {}
	local ok, result = pcall(function()
		return listfiles(MACRO_DIR)
	end)
	if ok and result then
		for _, f in ipairs(result) do
			if f:match("%.json$") then
				local name = f:match("([^/\\]+)%.json$")
				if name and name ~= "config" and not name:match("%.rec$") then
					table.insert(files, name)
				end
			end
		end
	end
	return files
end

local function recPath(name)
	return MACRO_DIR..(name or Macro.CurrentMacroName or "default")..".rec.json"
end

local function deleteRec(name)
	pcall(function()
		local p = recPath(name)
		if isfile(p) then delfile(p) end
	end)
end

function Macro.Save(name)
	name = name or Macro.CurrentMacroName or "default"
	Macro.CurrentMacroName = name
	Macro.Meta.units = collectUnits(Macro.Actions)
	local data = {
		version = 4,
		actions = Macro.Actions,
		targetLevels = Macro.TargetLevels,
		settings = Macro.Settings,
		meta = Macro.Meta,
		savedAt = os.date("%Y-%m-%d %H:%M:%S"),
	}
	local path = MACRO_DIR..name..".json"
	local ok, err = pcall(function()
		writefile(path, HttpService:JSONEncode(data))
	end)
	if ok then
		deleteRec(name)
		print("[Macro] Saved: "..path.." ("..#Macro.Actions.." actions)")
		if updateMacroInfo then pcall(updateMacroInfo, name) end
		return path
	end
	warn("[Macro] Save failed: "..tostring(err))
	return nil
end

function Macro.Load(name)
	name = name or Macro.CurrentMacroName or "default"
	Macro.CurrentMacroName = name
	local path = MACRO_DIR..name..".json"
	if not isfile(path) then
		warn("[Macro] Not found: "..path)
		return false
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(path))
	end)
	if not ok or type(data) ~= "table" then
		warn("[Macro] Bad json: "..path)
		return false
	end
	Macro.Actions = data.actions or {}
	Macro.TargetLevels = {}
	Macro.Meta = type(data.meta) == "table" and data.meta or { matches = {} }
	if type(Macro.Meta.matches) ~= "table" then Macro.Meta.matches = {} end
	if type(data.settings) == "table" then
		-- из макроса берём только «макросные» настройки; пользовательские
		-- (AfterMatch, SmartUpgrade, AntiAfk, Speed15, MenuVisible, AutoReconnect)
		-- живут в config.json и не должны затираться при загрузке записи
		for _, k in ipairs({ "VoteMode", "PlaceByTimer", "AutoSkipBeforeRecord" }) do
			if data.settings[k] ~= nil then Macro.Settings[k] = data.settings[k] end
		end
		saveConfig()
	end
	Macro.BuildTargetLevels()
	Config.lastMacro = name
	saveConfig()
	print(string.format("[Macro] Loaded %s: %d actions", name, #Macro.Actions))
	if applyConfigToUI then pcall(applyConfigToUI) end
	if updateMacroInfo then pcall(updateMacroInfo, name) end
	task.delay(1.5, function()
		pcall(function()
			if type(applyLoadout) == "function" then applyLoadout() end
		end)
	end)
	if autoJoinWanted() and inLobby() then
		local ok = pcall(startAutoJoin)
		if not ok then print("[Macro] autoJoin после Load не стартовал") end
	end
	return true
end

function Macro.DeleteMacro(name)
	if not name or name == "" or name == "config" then
		warn("[Macro] Удаление запрещено: "..tostring(name))
		return false
	end
	local path = MACRO_DIR..name..".json"
	if isfile(path) then
		delfile(path)
		deleteRec(name)
		print("[Macro] Deleted: "..name)
		return true
	end
	return false
end

function Macro.List()
	for i, a in ipairs(Macro.Actions) do
		print(string.format("  #%d t=%.2f %s", i, a.t or 0, a.type))
	end
end

