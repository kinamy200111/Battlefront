	InfoBox:AddLabel("Auto-Upgrade сам качает башни по твоей записи. Auto-Skip сам пропускает волны. Монет/ч и Конфет/ч считаются по последним каткам. Юниты из макроса надеваются сами при загрузке. Карта берётся из записи, голосование — из настроек.", true)

	return Window
end

-- ========== Anti-AFK ==========

local function initAntiAfk()
	if G.CameraTDAntiAfk then return end
	G.CameraTDAntiAfk = true
	if LocalPlayer then
		pcall(function()
			LocalPlayer.Idled:Connect(function()
				if Macro.Settings.AntiAfk == false then return end
				pcall(function()
					local VirtualUser = game:GetService("VirtualUser")
					VirtualUser:CaptureController()
					VirtualUser:ClickButton2(Vector2.new(0, 0))
				end)
				print("[Macro] Anti-AFK: простой сброшен (Idled)")
			end)
		end)
	end
	track(function()
		while true do
			task.wait(120)
			if Macro.Settings.AntiAfk ~= false then
				pcall(function()
					local loc = UserInputService:GetMouseLocation()
					VirtualInputManager:SendMouseMoveEvent(loc.X + 2, loc.Y + 2)
					VirtualInputManager:SendMouseMoveEvent(loc.X, loc.Y)
				end)
			end
		end
	end)
	print("[Macro] Anti-AFK активен (проверка каждые 120с)")
end

-- ========== Hotkeys ==========

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.F1 then
		if Window and Window.Toggle then
			Window:Toggle()
			if Toggles and Toggles.MenuToggle then
				Toggles.MenuToggle:SetValue(Library.Toggled)
			end
		end
	elseif input.KeyCode == Enum.KeyCode.F6 then
		if Macro.Recording then Macro.StopRecording() else Macro.StartRecording() end
	elseif input.KeyCode == Enum.KeyCode.F7 then
		if ensureLoaded() then
			track(function() Macro.Play() end)
		else
			notify("Error", "Нет действий — загрузи макрос (F10)")
		end
	elseif input.KeyCode == Enum.KeyCode.F8 then
		Macro.Stop()
	elseif input.KeyCode == Enum.KeyCode.F9 then
		Macro.Save(Macro.CurrentMacroName)
		if macroDropdownRef then macroDropdownRef:SetValues(refreshMacroList()) end
	elseif input.KeyCode == Enum.KeyCode.F10 then
		Macro.Load(Macro.CurrentMacroName)
	end
end)

-- ========== Boot ==========

local recName, recCount = recoverRec()

makeUI()

if recName then
	notify("Восстановлено", recName..": "..recCount.." действий (незавершённая запись)")
	if macroDropdownRef then macroDropdownRef:SetValues(refreshMacroList()) end
	updateMacroInfo(recName)
elseif (Config.autoload or (Config.farm and Config.farm.active)) and Config.lastMacro then
	if Macro.Load(Config.lastMacro) then
		notify("Autoload", "Макрос: "..Config.lastMacro.." ("..#Macro.Actions.." действий)")
	end
else
	updateMacroInfo(Macro.CurrentMacroName)
end

applyConfigToUI()

if Config.settings.MenuVisible == false then
	task.delay(1.5, function()
		pcall(function()
			if Library and Library.Toggled then
				Window:Toggle(false)
			end
		end)
	end)
end

if not ConfigRead then
	task.delay(3, function()
		loadConfig()
		if not ConfigRead then return end
		Macro.Settings = Config.settings
		applyConfigToUI()
		if not next(Macro.Actions) and (Config.autoload or (Config.farm and Config.farm.active)) and Config.lastMacro then
			pcall(function() Macro.Load(Config.lastMacro) end)
		end
		updateMacroInfo(Macro.CurrentMacroName)
		updateFarmLabel()
		print("[Macro] Конфиг подгружен с повтора: autoJoin="..tostring(Config.autoJoin).." lastMacro="..tostring(Config.lastMacro))
	end)
end

if Config.autoExecute ~= false then
	armTeleportQueue()
	pcall(function()
		writefile("autoexec/MacroSystem.lua", LOADER_SRC)
	end)
else
	pcall(function()
		if isfile("autoexec/MacroSystem.lua") then deletefile("autoexec/MacroSystem.lua") end
	end)
end

track(function()
	while true do
		if Macro.Recording then pcall(autosaveRecording) end
		task.wait(15)
	end
end)

track(function()
	while true do
		pcall(tradePollOnce)
		task.wait(1.2)
	end
end)

initAntiAfk()

if Macro.Settings.AutoReconnect ~= false then
	Macro.SetAutoReconnect(true)
end

if inLobby() then
	connectElevatorEvents()
	if autoJoinWanted() then startAutoJoin() end
else
	track(matchWatcher)
	if (Config.autoload or (Config.farm and Config.farm.active)) and #Macro.Actions > 0 then
		track(function()
			local pg = LocalPlayer and LocalPlayer.PlayerGui
			local gui = pg and pg:WaitForChild("GameUI", 40)
			if not gui then return end
			task.wait(2.5)
			local final = gui:FindFirstChild("FinalUI")
			if final and final.Visible then return end
			if Macro.Recording or Macro.Playing then return end
			notify("Autoload", "Продолжаю макрос: "..tostring(Macro.CurrentMacroName))
			Macro.Play()
		end)
	end
end

print("[Macro] System v4 loaded! place="..game.PlaceId.." autoload="..tostring(Config.autoload).." autoJoin="..tostring(Config.autoJoin))
do
	local o = Config.posOffset or {}
	if (o.x or 0) ~= 0 or (o.y or 0) ~= 0 or (o.z or 0) ~= 0 then
		print(string.format("[Macro] posOffset active: %.1f, %.1f, %.1f", o.x or 0, o.y or 0, o.z or 0))
	end
