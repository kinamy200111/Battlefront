local Config
local _areaBounds, _areaRef
local function getAreaBounds()
	local area = workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("TowerArea")
	if not area then
		_areaBounds, _areaRef = nil, nil
		return nil
	end
	if _areaRef ~= area or _areaBounds == nil then
		_areaRef = area
		_areaBounds = false
		local minP, maxP
		for _, p in ipairs(area:GetDescendants()) do
			if p:IsA("BasePart") then
				local cf, s = p.CFrame, p.Size
				for _, dx in ipairs({ -s.X / 2, s.X / 2 }) do
					for _, dy in ipairs({ -s.Y / 2, s.Y / 2 }) do
						for _, dz in ipairs({ -s.Z / 2, s.Z / 2 }) do
							local c = (cf * CFrame.new(dx, dy, dz)).Position
							if not minP then
								minP, maxP = c, c
							else
								minP = Vector3.new(math.min(minP.X, c.X), math.min(minP.Y, c.Y), math.min(minP.Z, c.Z))
								maxP = Vector3.new(math.max(maxP.X, c.X), math.max(maxP.Y, c.Y), math.max(maxP.Z, c.Z))
							end
						end
					end
				end
			end
		end
		if minP then _areaBounds = { min = minP, max = maxP } end
	end
	return _areaBounds or nil
end
local function posInArea(pos, margin)
	local b = getAreaBounds()
	if not b then return true end
	margin = margin or 20
	return pos.X >= b.min.X - margin and pos.X <= b.max.X + margin
		and pos.Z >= b.min.Z - margin and pos.Z <= b.max.Z + margin
		and pos.Y >= b.min.Y - margin and pos.Y <= b.max.Y + margin
end
local function applyOffset(p)
	if not p or typeof(p) ~= "Vector3" then return p end
	if posInArea(p) then return p end
	local o = Config and Config.posOffset
	if o then
		local dx, dy, dz = o.x or 0, o.y or 0, o.z or 0
		if dx ~= 0 or dy ~= 0 or dz ~= 0 then
			local shifted = p + Vector3.new(dx, dy, dz)
			if posInArea(shifted) then return shifted end
		end
	end
	return p
end

