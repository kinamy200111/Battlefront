local ElevatorCtl = {
	insideName = nil,
	insideModel = nil,
	canStart = false,
	teleporting = false,
	lastStartTry = 0,
	startFails = 0,
	joinRunning = false,
}

autoJoinWanted = function()
	return Config.autoJoin == true or (Config.farm and Config.farm.active == true)
end

local function getElevatorGui()
	local pg = LocalPlayer and LocalPlayer.PlayerGui
	return pg and pg:FindFirstChild("ElevatorGui")
end

local function queueFrameVisible()
	local g = getElevatorGui()
	local q = g and g:FindFirstChild("QueueFrame")
	return q ~= nil and q.Visible == true
end

local function detectInsideModel()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local folder = workspace:FindFirstChild("Elevators")
	if not folder then return nil end
	for _, m in ipairs(folder:GetChildren()) do
		if m:IsA("Model") then
			local part = m:FindFirstChild("Area") or m:FindFirstChild("Hitbox") or m:FindFirstChildWhichIsA("BasePart")
			if part and part:IsA("BasePart") then
				local p = part.CFrame:PointToObjectSpace(hrp.Position)
				local h = part.Size * 0.5
				if math.abs(p.X) <= h.X and math.abs(p.Y) <= h.Y and math.abs(p.Z) <= h.Z then
					return m
				end
			end
		end
	end
	return nil
end

local lastWaitMapLog = 0
local function normMap(s)
	if type(s) ~= "string" then return "" end
	local n = s:lower():gsub("^map:%s*", "")
	n = n:gsub("[%s_%-]+", "")
	return n
end
local function pickElevator()
	local want = Macro.Meta and Macro.Meta.map
	local wantN = normMap(want)
	local exact, empties = nil, {}
	local folder = workspace:FindFirstChild("Elevators")
	if not folder then return nil end
	for _, m in ipairs(folder:GetChildren()) do
		if m:IsA("Model") and (m:GetAttribute("Players") or 0) == 0 then
			local map = m:GetAttribute("Map")
			if wantN ~= "" and normMap(map) == wantN then
				exact = m
			end
			empties[#empties + 1] = m
		end
	end
	if want and wantN ~= "" then
		if exact then return exact end
		if os.clock() - lastWaitMapLog > 5 then
			lastWaitMapLog = os.clock()
			print("[Macro] Жду лифт с картой: "..tostring(want))
		end
		return nil
	end
	if #empties == 0 then return nil end
	return empties[math.random(#empties)]
end

local function pivotInto(model)
	local part = model:FindFirstChild("Hitbox") or model:FindFirstChildWhichIsA("BasePart")
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (part and hrp) then return false end
	hrp.CFrame = part.CFrame
	return true
end

startAutoJoin = function()
	if ElevatorCtl.joinRunning then return end
	if #Macro.Actions == 0 then
		print("[Macro] AutoJoin: нет загруженного макроса — сначала Load (или включи фарм)")
		return
	end
	ElevatorCtl.joinRunning = true
	track(function()
		print("[Macro] AutoJoin старт")
		while autoJoinWanted() and inLobby() and not ElevatorCtl.teleporting do
			local ok, err = pcall(function()
				if queueFrameVisible() then
					local model = detectInsideModel() or ElevatorCtl.insideModel
					if model and model.Parent then
						local players = model:GetAttribute("Players") or 0
						if players > 1 then
							print("[Macro] Лифт занят ("..players.."), выходим")
							invokeRemote("ElevatorLeave", model.Name)
							ElevatorCtl.insideModel = nil
							task.wait(1.2)
						else
							if os.clock() - ElevatorCtl.lastStartTry > 1.5 then
								ElevatorCtl.lastStartTry = os.clock()
								local res = invokeRemote("ElevatorStart", model.Name)
								print("[Macro] ElevatorStart("..model.Name..") -> "..tostring(res)
									.." canStart="..tostring(ElevatorCtl.canStart))
								if res == false then
									ElevatorCtl.startFails = ElevatorCtl.startFails + 1
									if ElevatorCtl.startFails >= 3 then
										local g = getElevatorGui()
										local q = g and g:FindFirstChild("QueueFrame")
										local rb = q and q:FindFirstChild("ReadyButton")
										if rb and rb.Visible then
											vimClick(rb)
											print("[Macro] ReadyButton кликнут")
										end
									end
								else
									ElevatorCtl.startFails = 0
								end
							end
						end
					end
				else
					ElevatorCtl.insideModel = nil
					local model = pickElevator()
					if model then
						if pivotInto(model) then
							ElevatorCtl.insideModel = model
							print("[Macro] Захожу в "..model.Name.." (карта "..tostring(model:GetAttribute("Map"))..")")
							task.wait(0.9)
							if not queueFrameVisible() then
								invokeRemote("ElevatorEnter", model.Name)
								task.wait(0.6)
							end
						end
					end
				end
			end)
			if not ok then warn("[Macro] join: "..tostring(err)) end
			task.wait(0.4)
		end
		ElevatorCtl.joinRunning = false
		print("[Macro] AutoJoin остановлен")
	end)
end

local function connectElevatorEvents()
	pcall(function()
		NetworkFolder:WaitForChild("ElevatorTeleporting", 10).OnClientEvent:Connect(function()
			ElevatorCtl.teleporting = true
			local model = ElevatorCtl.insideModel or detectInsideModel()
			if model and model.Parent then
				Config.lastMap = model:GetAttribute("Map")
			end
			saveConfig()
			armTeleportQueue()
			notify("Телепорт в катку", "Карта: "..tostring(Config.lastMap or "?"))
		end)
	end)
	pcall(function()
		NetworkFolder:WaitForChild("ElevatorEntered", 10).OnClientEvent:Connect(function(name, canStart)
			ElevatorCtl.insideName = name
			local folder = workspace:FindFirstChild("Elevators")
			ElevatorCtl.insideModel = folder and folder:FindFirstChild(name)
			ElevatorCtl.canStart = canStart == true
		end)
	end)
	pcall(function()
		NetworkFolder:WaitForChild("ElevatorLeft", 10).OnClientEvent:Connect(function()
			ElevatorCtl.insideName = nil
			ElevatorCtl.insideModel = nil
			ElevatorCtl.canStart = false
		end)
	end)
end

